		"test": "npm run build && node --test test/*.test.ts"
	},
	"dependencies": {
		"lib0": "^0.2.114",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.33"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"esbuild": "^0.27.0",
		"typescript": "^5.9.0"
	}
}
