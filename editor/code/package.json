{
	"name": "hangar-code",
	"private": true,
	"description": "The Code tab's service in the guest: files, git, and shared documents.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/code.mjs",
