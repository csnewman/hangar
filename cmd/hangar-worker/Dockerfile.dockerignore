!fs/Cargo.toml
!fs/Cargo.lock
!fs/src/
!gpu/Cargo.toml
!gpu/Cargo.lock
!gpu/src/
!gpu/virglrenderer/
!editor/
!images/
internal/webui/dist/app
editor/code/node_modules
editor/code/dist
