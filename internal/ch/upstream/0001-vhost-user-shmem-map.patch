new file mode 100644
index 000000000..d8a140670
--- /dev/null
+++ b/virtio-devices/src/vhost_user/shmem.rs
@@ -0,0 +1,171 @@
+// Copyright © 2026 Cloud Hypervisor contributors
+//
+// SPDX-License-Identifier: Apache-2.0
+
+//! Placing a backend's memory inside a device's shared memory windows.
+//!
+//! A vhost-user device may publish one or more shared memory regions to the
+//! guest, each appearing as part of a PCI BAR. The backend owns what is in
+//! them: it asks the frontend to map a file descriptor at an offset inside a
+//! region, and to remove it again. virtio-fs uses this for a DAX cache and
+//! virtio-gpu for host-visible blob resources.
+//!
+//! The frontend's job is to keep those placements inside the window it
+//! published. The guest has the whole window mapped already, so memory placed
+//! here becomes visible without any further change to the address space.
+
+use std::io;
+use std::os::unix::io::AsRawFd;
+use std::sync::Arc;
+
+use vhost::vhost_user::message::{VhostUserMMap, VhostUserMMapFlags};
+
+use crate::{MmapRegion, VirtioSharedMemoryList};
+
+/// The windows one device has published, addressed by the identifier the
+/// guest looks them up by.
+pub struct ShmemRegions {
+    regions: Vec<(u8, Arc<MmapRegion>, u64, u64)>,
+}
+
+impl ShmemRegions {
+    pub fn new(list: &VirtioSharedMemoryList) -> Self {
+        let regions = list
+            .region_list
+            .iter()
+            .map(|r| (r.id, Arc::clone(&list.mapping), r.offset, r.len))
+            .collect();
+        ShmemRegions { regions }
+    }
+
+    /// Resolve a request to a host address inside the named window.
+    ///
+    /// Everything here comes from the backend, which is a separate process
+    /// and not necessarily a trusted one, so a request that overflows or
+    /// leaves the window is refused rather than passed to mmap.
+    fn resolve(&self, req: &VhostUserMMap) -> io::Result<*mut libc::c_void> {
+        let einval = || io::Error::from_raw_os_error(libc::EINVAL);
+        let (_, mapping, base, len) = self
+            .regions
+            .iter()
+            .find(|(id, ..)| *id == req.shmid)
+            .ok_or_else(einval)?;
+
+        let end = req.shm_offset.checked_add(req.len).ok_or_else(einval)?;
+        if req.len == 0 || end > *len {
+            return Err(einval());
+        }
+        let within = base.checked_add(req.shm_offset).ok_or_else(einval)?;
+        if within.checked_add(req.len).ok_or_else(einval)? > mapping.size() as u64 {
+            return Err(einval());
+        }
+        Ok((mapping.as_ptr() as u64 + within) as *mut libc::c_void)
+    }
+
+    /// Place the backend's file descriptor inside the window.
+    pub fn map(&self, req: &VhostUserMMap, fd: &dyn AsRawFd) -> io::Result<u64> {
+        let addr = self.resolve(req)?;
+        let flags = VhostUserMMapFlags::from_bits_truncate(req.flags);
+        // The guest's memory slot is writable, so KVM lets a guest write
+        // anywhere in the window and only the host mapping can refuse. A
+        // refusal there leaves KVM_RUN with EFAULT and kills the VM rather
+        // than faulting the guest, so the mapping is always writable. A
+        // read-only descriptor cannot be shared writably, so those become
+        // private: a guest that writes gets its own copy, and readers still
+        // share the backend's pages.
+        let writable = flags.contains(VhostUserMMapFlags::WRITABLE);
+        let prot = libc::PROT_READ | libc::PROT_WRITE;
+        let share = if writable {
+            libc::MAP_SHARED
+        } else {
+            libc::MAP_PRIVATE
+        };
+
+        // A backend maps at its own granularity, which may run past the end
+        // of the file: virtio-fs asks for 2 MiB at a time whatever the file's
+        // size. mmap accepts that, but touching a page beyond the end of a
+        // shared file mapping faults, and a fault inside a memory slot leaves
+        // KVM_RUN with EFAULT and kills the VM rather than the guest. So only
+        // the part the file actually covers is mapped from it.
+        // SAFETY: FFI call with an owned descriptor.
+        let mut st: libc::stat = unsafe { std::mem::zeroed() };
+        // SAFETY: st is valid for the duration of the call.
+        if unsafe { libc::fstat(fd.as_raw_fd(), &mut st) } != 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let available = (st.st_size as u64).saturating_sub(req.fd_offset);
+        // Whole pages only; a partial tail page is backed by the file and the
+        // kernel zeroes the rest of it.
+        let from_file = std::cmp::min(req.len, available.next_multiple_of(4096));
+
+        if from_file > 0 {
+            // MAP_FIXED over a window the guest already has mapped. The
+            // invalidation this causes is what makes the new pages visible to
+            // the guest without touching its memory slots.
+            // SAFETY: addr and len were checked to lie inside the window.
+            let ret = unsafe {
+                libc::mmap(
+                    addr,
+                    from_file as usize,
+                    prot,
+                    share | libc::MAP_FIXED,
+                    fd.as_raw_fd(),
+                    req.fd_offset as libc::off_t,
+                )
+            };
+            if ret == libc::MAP_FAILED {
+                return Err(io::Error::last_os_error());
+            }
+        }
+
+        // Anything the file does not reach reads as zeroes rather than
+        // faulting.
+        if from_file < req.len {
+            let tail = (addr as u64 + from_file) as *mut libc::c_void;
+            // SAFETY: the whole range was checked to lie inside the window.
+            let ret = unsafe {
+                libc::mmap(
+                    tail,
+                    (req.len - from_file) as usize,
+                    libc::PROT_READ | libc::PROT_WRITE,
+                    libc::MAP_ANONYMOUS
+                        | libc::MAP_PRIVATE
+                        | libc::MAP_FIXED
+                        | libc::MAP_NORESERVE,
+                    -1,
+                    0,
+                )
+            };
+            if ret == libc::MAP_FAILED {
+                return Err(io::Error::last_os_error());
+            }
+        }
+        Ok(0)
+    }
+
+    /// Take it away again, leaving the range absent.
+    ///
+    /// The range becomes unreadable rather than keeping whatever the backend
+    /// last put there, so a guest reading a stale offset sees
+    /// nothing rather than another resource's memory. It stays readable,
+    /// because an absent page inside a memory slot becomes EFAULT out of
+    /// KVM_RUN.
+    pub fn unmap(&self, req: &VhostUserMMap) -> io::Result<u64> {
+        let addr = self.resolve(req)?;
+        // SAFETY: addr and len were checked to lie inside the window.
+        let ret = unsafe {
+            libc::mmap(
+                addr,
+                req.len as usize,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_ANONYMOUS | libc::MAP_PRIVATE | libc::MAP_FIXED | libc::MAP_NORESERVE,
+                -1,
+                0,
+            )
+        };
+        if ret == libc::MAP_FAILED {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(0)
+    }
+}
