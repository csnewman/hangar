+
+        let blob_window_mib = parser
+            .convert::<u64>("blob_window_mib")
+            .map_err(Error::ParseGpu)?
+            .unwrap_or(512);
+
+        let pci_common = PciDeviceCommonConfig::parse(gpu)?;
+
+        Ok(GpuConfig {
+            pci_common,
+            virgl,
+            venus,
+            blob_window_mib,
+        })
+    }
