+    fn make_virtio_gpu_devices(&mut self, snapshot: Option<&Snapshot>) -> DeviceManagerResult<()> {
+        let mut gpu_config = self.config.lock().unwrap().gpu.clone();
+        if let Some(gpu_config) = &mut gpu_config {
+            let id = match gpu_config.pci_common.id.as_ref() {
+                Some(id) => id.clone(),
+                None => gpu_config
+                    .pci_common
+                    .id
+                    .insert(self.next_device_name(GPU_DEVICE_NAME_PREFIX)?)
+                    .clone(),
+            };
+            info!("Creating virtio-gpu device: id = {id}");
+
+            // The window a guest maps blob resources into. It is host memory
+            // placed in the guest's address space through a dedicated PCI BAR,
+            // and the renderer maps each blob over a slice of it, so the guest
+            // reads the renderer's own pages rather than a copy.
+            let cache_size = gpu_config.blob_window_mib << 20;
+            let cache = if cache_size > 0 {
+                let mmap_region = MmapRegion::build(
+                    None,
+                    cache_size as usize,
+                    libc::PROT_NONE,
+                    libc::MAP_ANONYMOUS | libc::MAP_PRIVATE | libc::MAP_NORESERVE,
+                )
+                .map_err(DeviceManagerError::NewMmapRegion)?;
+
+                // 2 MiB alignment so the window can be backed by huge pages.
+                let region_base = self.pci_segments
+                    [gpu_config.pci_common.pci_segment as usize]
+                    .mem64_allocator
+                    .lock()
+                    .unwrap()
+                    .allocate(None, cache_size, Some(0x0020_0000))
+                    .ok_or(DeviceManagerError::GpuRangeAllocation)?;
+
+                // SAFETY: host_addr covers cache_size bytes of mapped memory.
+                let mem_slot = unsafe {
+                    self.memory_manager
+                        .lock()
+                        .unwrap()
+                        .create_userspace_mapping(
+                            region_base.raw_value(),
+                            cache_size as usize,
+                            mmap_region.as_ptr(),
+                            false,
+                            false,
+                            false,
+                        )
+                        .map_err(DeviceManagerError::MemoryManager)?
+                };
+
+                Some(virtio_devices::VirtioSharedMemoryList {
+                    mem_slot,
+                    addr: region_base,
+                    mapping: Arc::new(mmap_region),
+                    region_list: vec![virtio_devices::VirtioSharedMemory {
+                        // VIRTIO_GPU_SHM_ID_HOST_VISIBLE
+                        id: 1,
+                        offset: 0,
+                        len: cache_size,
+                    }],
+                })
+            } else {
+                None
+            };
+
+            let virtio_gpu_device = Arc::new(Mutex::new(
+                virtio_devices::gpu::Gpu::new(
+                    id.clone(),
+                    virtio_devices::gpu::GpuCapsets {
+                        virgl: gpu_config.virgl,
+                        venus: gpu_config.venus,
+                    },
+                    cache,
+                    self.force_access_platform | gpu_config.pci_common.iommu,
+                    self.seccomp_action.clone(),
+                    self.exit_evt
+                        .try_clone()
+                        .map_err(DeviceManagerError::EventFd)?,
+                    state_from_id(snapshot, id.as_str())
+                        .map_err(DeviceManagerError::RestoreGetState)?,
+                )
+                .map_err(DeviceManagerError::CreateVirtioGpu)?,
+            ));
+
+            self.virtio_devices.push(MetaVirtioDevice {
+                virtio_device: Arc::clone(&virtio_gpu_device)
+                    as Arc<Mutex<dyn virtio_devices::VirtioDevice>>,
+                pci_common: gpu_config.pci_common.clone(),
+                dma_handler: None,
+            });
+
+            self.device_tree
+                .lock()
+                .unwrap()
+                .insert(id.clone(), device_node!(id, virtio_gpu_device));
+        }
+        self.config.lock().unwrap().gpu = gpu_config;
+        Ok(())
+    }
