 fn vmm_thread_rules(
     hypervisor_type: HypervisorType,
+) -> Result<Vec<(i64, Vec<SeccompRule>)>, BackendError> {
+    let mut rules = vmm_thread_rules_inner(hypervisor_type)?;
+    if gpu_enabled() {
+        // Appended last so the unconditional ioctl replaces the allowlist
+        // when these are collected into the filter's map.
+        rules.append(&mut gpu_host_rules());
+    }
+    Ok(rules)
+}
