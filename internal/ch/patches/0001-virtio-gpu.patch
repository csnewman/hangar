diff --git a/virtio-devices/src/gpu.rs b/virtio-devices/src/gpu.rs
new file mode 100644
index 000000000..23f368b05
--- /dev/null
+++ b/virtio-devices/src/gpu.rs
@@ -0,0 +1,734 @@
+// SPDX-License-Identifier: Apache-2.0 AND BSD-3-Clause
+
+//! virtio-gpu, rendered in this process by rutabaga_gfx.
+//!
+//! The device is in-tree rather than a vhost-user backend because virtio-gpu
+//! cannot be carried over vhost-user here: the frontend has to answer
+//! device-specific protocol messages and hand the backend a shared memory
+//! window, and this monitor implements neither. In-process the question does
+//! not arise -- the device reads its own virtqueues and owns the window
+//! directly.
+
+use std::io;
+use std::ops::Deref;
+use std::os::unix::io::AsRawFd;
+use std::sync::atomic::AtomicBool;
+use std::sync::{Arc, Barrier};
+
+use anyhow::anyhow;
+use event_monitor::event;
+use log::{debug, error, info, warn};
+use rutabaga_gfx::{
+    Rutabaga, RutabagaBuilder, RutabagaComponentType, RutabagaFence, RutabagaFenceHandler,
+    RUTABAGA_CAPSET_VENUS, RUTABAGA_CAPSET_VIRGL, RUTABAGA_CAPSET_VIRGL2,
+};
+use seccompiler::SeccompAction;
+use serde::{Deserialize, Serialize};
+use smallvec::SmallVec;
+use thiserror::Error;
+use virtio_queue::{Queue, QueueT};
+use vm_memory::{ByteValued, Bytes, GuestAddressSpace, GuestMemoryAtomic};
+use vm_migration::{Migratable, MigratableError, Pausable, Snapshot, Snapshottable, Transportable};
+use vm_virtio::checked_descriptor::DescriptorChainExt;
+use vm_virtio::AccessPlatform;
+use vmm_sys_util::eventfd::EventFd;
+
+use super::{
+    ActivateResult, EpollHelper, EpollHelperError, EpollHelperHandler, Error as DeviceError,
+    VirtioCommon, VirtioDevice, VirtioDeviceType, EPOLL_HELPER_EVENT_LAST,
+    VIRTIO_F_ACCESS_PLATFORM, VIRTIO_F_VERSION_1,
+};
+use crate::device::ActivationContext;
+use crate::seccomp_filters::Thread;
+use crate::{GuestMemoryMmap, VirtioInterrupt, VirtioInterruptType};
+
+const QUEUE_SIZE: u16 = 256;
+const NUM_QUEUES: usize = 2;
+const QUEUE_SIZES: &[u16] = &[QUEUE_SIZE; NUM_QUEUES];
+
+/// The queue the guest submits rendering commands on.
+const CONTROL_QUEUE: u16 = 0;
+/// The queue carrying cursor updates, kept separate so a busy renderer never
+/// delays the pointer.
+const CURSOR_QUEUE: u16 = 1;
+
+const CONTROL_QUEUE_EVENT: u16 = EPOLL_HELPER_EVENT_LAST + 1;
+const CURSOR_QUEUE_EVENT: u16 = EPOLL_HELPER_EVENT_LAST + 2;
+
+// Feature bits from the virtio specification.
+const VIRTIO_GPU_F_VIRGL: u32 = 0;
+const VIRTIO_GPU_F_CONTEXT_INIT: u32 = 4;
+
+// Commands. 2D and capset queries are answered here; the 3D commands arrive
+// once the guest has negotiated VIRGL.
+const VIRTIO_GPU_CMD_GET_DISPLAY_INFO: u32 = 0x0100;
+const VIRTIO_GPU_CMD_GET_CAPSET_INFO: u32 = 0x0108;
+const VIRTIO_GPU_CMD_GET_CAPSET: u32 = 0x0109;
+
+// Responses.
+const VIRTIO_GPU_RESP_OK_NODATA: u32 = 0x1100;
+const VIRTIO_GPU_RESP_OK_DISPLAY_INFO: u32 = 0x1101;
+const VIRTIO_GPU_RESP_OK_CAPSET_INFO: u32 = 0x1102;
+const VIRTIO_GPU_RESP_OK_CAPSET: u32 = 0x1103;
+const VIRTIO_GPU_RESP_ERR_UNSPEC: u32 = 0x1200;
+const VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER: u32 = 0x1205;
+
+/// The specification fixes the number of scanouts a device may expose.
+const VIRTIO_GPU_MAX_SCANOUTS: usize = 16;
+
+const DEFAULT_WIDTH: u32 = 1280;
+const DEFAULT_HEIGHT: u32 = 800;
+
+#[derive(Error, Debug)]
+enum Error {
+    #[error("Failed adding used index")]
+    QueueAddUsed(#[source] virtio_queue::Error),
+    #[error("Descriptor chain carried no readable command")]
+    NoCommand,
+    #[error("Descriptor chain left nowhere to put the response")]
+    NoResponseBuffer,
+    #[error("Guest memory access failed")]
+    GuestMemory(#[source] vm_memory::GuestMemoryError),
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default)]
+struct CtrlHeader {
+    type_: u32,
+    flags: u32,
+    fence_id: u64,
+    ctx_id: u32,
+    ring_idx: u8,
+    padding: [u8; 3],
+}
+// SAFETY: plain data, no padding beyond the explicit field, no invalid values.
+unsafe impl ByteValued for CtrlHeader {}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default)]
+struct Rect {
+    x: u32,
+    y: u32,
+    width: u32,
+    height: u32,
+}
+// SAFETY: plain data.
+unsafe impl ByteValued for Rect {}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default)]
+struct DisplayOne {
+    r: Rect,
+    enabled: u32,
+    flags: u32,
+}
+// SAFETY: plain data.
+unsafe impl ByteValued for DisplayOne {}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct RespDisplayInfo {
+    hdr: CtrlHeader,
+    pmodes: [DisplayOne; VIRTIO_GPU_MAX_SCANOUTS],
+}
+// SAFETY: plain data.
+unsafe impl ByteValued for RespDisplayInfo {}
+
+impl Default for RespDisplayInfo {
+    fn default() -> Self {
+        Self {
+            hdr: CtrlHeader::default(),
+            pmodes: [DisplayOne::default(); VIRTIO_GPU_MAX_SCANOUTS],
+        }
+    }
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default)]
+struct GetCapsetInfo {
+    capset_index: u32,
+    padding: u32,
+}
+// SAFETY: plain data.
+unsafe impl ByteValued for GetCapsetInfo {}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default)]
+struct RespCapsetInfo {
+    hdr: CtrlHeader,
+    capset_id: u32,
+    capset_max_version: u32,
+    capset_max_size: u32,
+    padding: u32,
+}
+// SAFETY: plain data.
+unsafe impl ByteValued for RespCapsetInfo {}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default)]
+struct GetCapset {
+    capset_id: u32,
+    capset_version: u32,
+}
+// SAFETY: plain data.
+unsafe impl ByteValued for GetCapset {}
+
+/// The device configuration space the guest reads.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, Deserialize, Serialize)]
+pub struct VirtioGpuConfig {
+    events_read: u32,
+    events_clear: u32,
+    num_scanouts: u32,
+    num_capsets: u32,
+}
+// SAFETY: plain data.
+unsafe impl ByteValued for VirtioGpuConfig {}
+
+/// Which renderers the device offers the guest.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct GpuCapsets {
+    pub virgl: bool,
+    pub venus: bool,
+}
+
+impl Default for GpuCapsets {
+    fn default() -> Self {
+        Self {
+            virgl: true,
+            venus: false,
+        }
+    }
+}
+
+impl GpuCapsets {
+    /// How many capsets the guest will be able to enumerate.
+    fn count(&self) -> u32 {
+        let mut n = 0;
+        // virgl is offered as both the original and the version 2 capset,
+        // which is what a guest Mesa looks for.
+        if self.virgl {
+            n += 2;
+        }
+        if self.venus {
+            n += 1;
+        }
+        n
+    }
+
+    fn mask(&self) -> u64 {
+        let mut m = 0u64;
+        if self.virgl {
+            m |= (1 << RUTABAGA_CAPSET_VIRGL) | (1 << RUTABAGA_CAPSET_VIRGL2);
+        }
+        if self.venus {
+            m |= 1 << RUTABAGA_CAPSET_VENUS;
+        }
+        m
+    }
+}
+
+/// Builds the renderer.
+///
+/// EGL and the surfaceless platform are selected explicitly. A host with no
+/// `/dev/dri` has no GBM device, and virglrenderer dereferences a null
+/// context if it probes for one, so leaving the choice to it turns a headless
+/// host into a crash rather than a software-rendered guest.
+fn build_rutabaga(capsets: GpuCapsets) -> Result<Rutabaga, String> {
+    let handler = RutabagaFenceHandler::new(|_fence: RutabagaFence| {});
+    RutabagaBuilder::new(capsets.mask(), handler)
+        .set_use_egl(true)
+        .set_use_surfaceless(true)
+        .set_default_component(RutabagaComponentType::VirglRenderer)
+        .build()
+        .map_err(|e| format!("{e}"))
+}
+
+struct GpuEpollHandler {
+    mem: GuestMemoryAtomic<GuestMemoryMmap>,
+    ctrl_queue: Queue,
+    cursor_queue: Queue,
+    ctrl_evt: EventFd,
+    cursor_evt: EventFd,
+    interrupt_cb: Arc<dyn VirtioInterrupt>,
+    kill_evt: EventFd,
+    pause_evt: EventFd,
+    access_platform: Option<Arc<dyn AccessPlatform>>,
+    rutabaga: Rutabaga,
+}
+
+/// One command: the bytes the guest wrote, and where its answer goes.
+struct Request {
+    body: Vec<u8>,
+    resp_addrs: SmallVec<[(vm_memory::GuestAddress, u32); 4]>,
+}
+
+impl GpuEpollHandler {
+    /// Raise the interrupt for a queue. The transport indexes its queues, so
+    /// this takes the index rather than the queue itself.
+    fn signal(&self, queue_index: u16) -> Result<(), DeviceError> {
+        self.interrupt_cb
+            .trigger(VirtioInterruptType::Queue(queue_index))
+            .map_err(|e| {
+                error!("Failed to signal used queue: {e:?}");
+                DeviceError::FailedSignalingUsedQueue(e)
+            })
+    }
+
+    /// Split a chain into the command the guest wrote and the buffers it left
+    /// for the reply.
+    fn split(
+        desc_chain: &mut virtio_queue::DescriptorChain<
+            vm_memory::GuestMemoryLoadGuard<GuestMemoryMmap>,
+        >,
+        access_platform: Option<&dyn AccessPlatform>,
+    ) -> Result<Request, Error> {
+        let descs: SmallVec<[_; 8]> = desc_chain
+            .checked_iter(access_platform)
+            .collect::<Result<_, _>>()
+            .unwrap_or_default();
+
+        let mut body = Vec::new();
+        let mut resp_addrs = SmallVec::new();
+        for desc in &descs {
+            if desc.is_empty() {
+                continue;
+            }
+            if desc.is_write_only() {
+                resp_addrs.push((desc.addr(), desc.len()));
+            } else {
+                let mut buf = vec![0u8; desc.len() as usize];
+                desc_chain
+                    .memory()
+                    .read_slice(&mut buf, desc.addr())
+                    .map_err(Error::GuestMemory)?;
+                body.extend_from_slice(&buf);
+            }
+        }
+        if body.len() < std::mem::size_of::<CtrlHeader>() {
+            return Err(Error::NoCommand);
+        }
+        if resp_addrs.is_empty() {
+            return Err(Error::NoResponseBuffer);
+        }
+        Ok(Request { body, resp_addrs })
+    }
+
+    /// Write a response across the guest's reply buffers, returning how many
+    /// bytes were placed.
+    fn reply(
+        desc_chain: &virtio_queue::DescriptorChain<
+            vm_memory::GuestMemoryLoadGuard<GuestMemoryMmap>,
+        >,
+        resp_addrs: &[(vm_memory::GuestAddress, u32)],
+        bytes: &[u8],
+    ) -> Result<u32, Error> {
+        let mut written = 0usize;
+        for (addr, len) in resp_addrs {
+            if written >= bytes.len() {
+                break;
+            }
+            let n = std::cmp::min(*len as usize, bytes.len() - written);
+            desc_chain
+                .memory()
+                .write_slice(&bytes[written..written + n], *addr)
+                .map_err(Error::GuestMemory)?;
+            written += n;
+        }
+        Ok(written as u32)
+    }
+
+    fn header_of(type_: u32, request: &CtrlHeader) -> CtrlHeader {
+        CtrlHeader {
+            type_,
+            // A fence is only acknowledged if the guest asked for one.
+            flags: 0,
+            fence_id: request.fence_id,
+            ctx_id: request.ctx_id,
+            ring_idx: request.ring_idx,
+            padding: [0; 3],
+        }
+    }
+
+    /// Answer one command. Returns the bytes to place in the guest's reply
+    /// buffers.
+    fn dispatch(&mut self, body: &[u8]) -> Vec<u8> {
+        let hdr = match CtrlHeader::from_slice(&body[..std::mem::size_of::<CtrlHeader>()]) {
+            Some(h) => *h,
+            None => return Vec::new(),
+        };
+        let payload = &body[std::mem::size_of::<CtrlHeader>()..];
+
+        match hdr.type_ {
+            VIRTIO_GPU_CMD_GET_DISPLAY_INFO => {
+                let mut resp = RespDisplayInfo {
+                    hdr: Self::header_of(VIRTIO_GPU_RESP_OK_DISPLAY_INFO, &hdr),
+                    ..Default::default()
+                };
+                // One scanout, which is what a headless environment needs;
+                // the rest stay disabled.
+                resp.pmodes[0] = DisplayOne {
+                    r: Rect {
+                        x: 0,
+                        y: 0,
+                        width: DEFAULT_WIDTH,
+                        height: DEFAULT_HEIGHT,
+                    },
+                    enabled: 1,
+                    flags: 0,
+                };
+                resp.as_slice().to_vec()
+            }
+
+            VIRTIO_GPU_CMD_GET_CAPSET_INFO => {
+                let req = match GetCapsetInfo::from_slice(
+                    payload.get(..std::mem::size_of::<GetCapsetInfo>()).unwrap_or(&[]),
+                ) {
+                    Some(r) => *r,
+                    None => {
+                        return Self::header_of(VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER, &hdr)
+                            .as_slice()
+                            .to_vec()
+                    }
+                };
+                match self.rutabaga.get_capset_info(req.capset_index) {
+                    Ok((capset_id, capset_max_version, capset_max_size)) => RespCapsetInfo {
+                        hdr: Self::header_of(VIRTIO_GPU_RESP_OK_CAPSET_INFO, &hdr),
+                        capset_id,
+                        capset_max_version,
+                        capset_max_size,
+                        padding: 0,
+                    }
+                    .as_slice()
+                    .to_vec(),
+                    Err(e) => {
+                        warn!("get_capset_info({}) failed: {e}", req.capset_index);
+                        Self::header_of(VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER, &hdr)
+                            .as_slice()
+                            .to_vec()
+                    }
+                }
+            }
+
+            VIRTIO_GPU_CMD_GET_CAPSET => {
+                let req = match GetCapset::from_slice(
+                    payload.get(..std::mem::size_of::<GetCapset>()).unwrap_or(&[]),
+                ) {
+                    Some(r) => *r,
+                    None => {
+                        return Self::header_of(VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER, &hdr)
+                            .as_slice()
+                            .to_vec()
+                    }
+                };
+                match self
+                    .rutabaga
+                    .get_capset(req.capset_id, req.capset_version)
+                {
+                    Ok(caps) => {
+                        let mut out =
+                            Self::header_of(VIRTIO_GPU_RESP_OK_CAPSET, &hdr).as_slice().to_vec();
+                        out.extend_from_slice(&caps);
+                        out
+                    }
+                    Err(e) => {
+                        warn!("get_capset({}) failed: {e}", req.capset_id);
+                        Self::header_of(VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER, &hdr)
+                            .as_slice()
+                            .to_vec()
+                    }
+                }
+            }
+
+            other => {
+                debug!("virtio-gpu command {other:#06x} not handled yet");
+                Self::header_of(VIRTIO_GPU_RESP_ERR_UNSPEC, &hdr)
+                    .as_slice()
+                    .to_vec()
+            }
+        }
+    }
+
+    fn process(&mut self, which: u16) -> Result<bool, Error> {
+        let mem = self.mem.memory();
+        let mut used = false;
+        loop {
+            let queue = if which == CONTROL_QUEUE {
+                &mut self.ctrl_queue
+            } else {
+                &mut self.cursor_queue
+            };
+            let Some(mut desc_chain) = queue.pop_descriptor_chain(mem.clone()) else {
+                break;
+            };
+            let head = desc_chain.head_index();
+
+            let written = match Self::split(&mut desc_chain, self.access_platform.as_deref()) {
+                Ok(Request { body, resp_addrs }) => {
+                    let resp = self.dispatch(&body);
+                    Self::reply(&desc_chain, &resp_addrs, &resp)?
+                }
+                Err(e) => {
+                    warn!("Malformed virtio-gpu request: {e}");
+                    0
+                }
+            };
+
+            let queue = if which == CONTROL_QUEUE {
+                &mut self.ctrl_queue
+            } else {
+                &mut self.cursor_queue
+            };
+            queue
+                .add_used(mem.deref(), head, written)
+                .map_err(Error::QueueAddUsed)?;
+            used = true;
+        }
+        Ok(used)
+    }
+}
+
+impl GpuEpollHandler {
+    fn run(
+        &mut self,
+        paused: &AtomicBool,
+        paused_sync: &Barrier,
+    ) -> Result<(), EpollHelperError> {
+        let mut helper = EpollHelper::new(&self.kill_evt, &self.pause_evt)?;
+        helper.add_event(self.ctrl_evt.as_raw_fd(), CONTROL_QUEUE_EVENT)?;
+        helper.add_event(self.cursor_evt.as_raw_fd(), CURSOR_QUEUE_EVENT)?;
+        helper.run(paused, paused_sync, self)?;
+        Ok(())
+    }
+}
+
+impl EpollHelperHandler for GpuEpollHandler {
+    fn handle_event(
+        &mut self,
+        _helper: &mut EpollHelper,
+        event: &epoll::Event,
+    ) -> Result<(), EpollHelperError> {
+        let ev_type = event.data as u16;
+        let which = match ev_type {
+            CONTROL_QUEUE_EVENT => {
+                self.ctrl_evt.read().map_err(|e| {
+                    EpollHelperError::HandleEvent(anyhow!("Failed to get control event: {e:?}"))
+                })?;
+                CONTROL_QUEUE
+            }
+            CURSOR_QUEUE_EVENT => {
+                self.cursor_evt.read().map_err(|e| {
+                    EpollHelperError::HandleEvent(anyhow!("Failed to get cursor event: {e:?}"))
+                })?;
+                CURSOR_QUEUE
+            }
+            _ => {
+                return Err(EpollHelperError::HandleEvent(anyhow!(
+                    "Unexpected event: {ev_type}"
+                )))
+            }
+        };
+
+        let used = self.process(which).map_err(|e| {
+            EpollHelperError::HandleEvent(anyhow!("Failed to process queue: {e:?}"))
+        })?;
+        if used {
+            self.signal(which).map_err(|e| {
+                EpollHelperError::HandleEvent(anyhow!("Failed to signal used queue: {e:?}"))
+            })?;
+        }
+        Ok(())
+    }
+}
+
+/// A virtio-gpu device.
+pub struct Gpu {
+    common: VirtioCommon,
+    id: String,
+    config: VirtioGpuConfig,
+    capsets: GpuCapsets,
+    seccomp_action: SeccompAction,
+    exit_evt: EventFd,
+}
+
+#[derive(Deserialize, Serialize)]
+pub struct GpuState {
+    pub avail_features: u64,
+    pub acked_features: u64,
+    pub config: VirtioGpuConfig,
+}
+
+impl Gpu {
+    pub fn new(
+        id: String,
+        capsets: GpuCapsets,
+        access_platform_enabled: bool,
+        seccomp_action: SeccompAction,
+        exit_evt: EventFd,
+        state: Option<GpuState>,
+    ) -> io::Result<Gpu> {
+        // The count the guest reads follows from what is offered, rather than
+        // from starting the renderer. Building it here would run native
+        // graphics code on the monitor's own thread, which is both the wrong
+        // thread to own it and far outside that thread's syscall filter.
+        let num_capsets = capsets.count();
+        info!("virtio-gpu {id}: offering {num_capsets} capset(s)");
+
+        let (avail_features, acked_features, config, paused) = if let Some(state) = state {
+            info!("Restoring virtio-gpu {id}");
+            (
+                state.avail_features,
+                state.acked_features,
+                state.config,
+                true,
+            )
+        } else {
+            let mut avail_features = (1u64 << VIRTIO_F_VERSION_1)
+                | (1u64 << VIRTIO_GPU_F_VIRGL)
+                | (1u64 << VIRTIO_GPU_F_CONTEXT_INIT);
+            if access_platform_enabled {
+                avail_features |= 1u64 << VIRTIO_F_ACCESS_PLATFORM;
+            }
+            let config = VirtioGpuConfig {
+                events_read: 0,
+                events_clear: 0,
+                num_scanouts: 1,
+                num_capsets,
+            };
+            (avail_features, 0, config, false)
+        };
+
+        Ok(Gpu {
+            common: VirtioCommon {
+                device_type: VirtioDeviceType::Gpu as u32,
+                queue_sizes: QUEUE_SIZES.to_vec(),
+                paused_sync: Some(Arc::new(Barrier::new(2))),
+                avail_features,
+                acked_features,
+                min_queues: NUM_QUEUES as u16,
+                paused: Arc::new(AtomicBool::new(paused)),
+                ..Default::default()
+            },
+            id,
+            config,
+            capsets,
+            seccomp_action,
+            exit_evt,
+        })
+    }
+
+    fn state(&self) -> GpuState {
+        GpuState {
+            avail_features: self.common.avail_features,
+            acked_features: self.common.acked_features,
+            config: self.config,
+        }
+    }
+}
+
+impl VirtioDevice for Gpu {
+    fn device_type(&self) -> u32 {
+        self.common.device_type
+    }
+
+    fn queue_max_sizes(&self) -> &[u16] {
+        &self.common.queue_sizes
+    }
+
+    fn features(&self) -> u64 {
+        self.common.avail_features
+    }
+
+    fn ack_features(&mut self, value: u64) {
+        self.common.ack_features(value);
+    }
+
+    fn config_size(&self) -> Option<u64> {
+        Some(std::mem::size_of::<VirtioGpuConfig>() as u64)
+    }
+
+    fn read_config(&self, offset: u64, data: &mut [u8]) {
+        self.read_config_from_slice(self.config.as_slice(), offset, data);
+    }
+
+    fn activate(&mut self, context: ActivationContext) -> ActivateResult {
+        let ActivationContext {
+            mem,
+            interrupt_cb,
+            mut queues,
+            device_status,
+        } = context;
+        self.common.activate(&queues, interrupt_cb.clone())?;
+        let (kill_evt, pause_evt) = self.common.dup_eventfds()?;
+
+        let (_, ctrl_queue, ctrl_evt) = queues.remove(0);
+        let (_, cursor_queue, cursor_evt) = queues.remove(0);
+
+        // The renderer is neither Send nor Sync, so it is built on the worker
+        // thread rather than handed to it. Everything captured here is, which
+        // is why the handler is assembled inside the closure.
+        let capsets = self.capsets;
+        let access_platform = self.common.access_platform();
+        let interrupt_for_handler = interrupt_cb.clone();
+
+        let paused = self.common.paused.clone();
+        let paused_sync = self.common.paused_sync.clone();
+        self.common.spawn_worker(
+            &self.id,
+            &self.seccomp_action,
+            Thread::VirtioGpu,
+            &self.exit_evt,
+            device_status.clone(),
+            interrupt_cb.clone(),
+            move || {
+                let rutabaga = build_rutabaga(capsets).map_err(|e| {
+                    EpollHelperError::CreateFd(std::io::Error::other(format!(
+                        "virtio-gpu renderer failed to start: {e}"
+                    )))
+                })?;
+                let mut handler = GpuEpollHandler {
+                    mem,
+                    ctrl_queue,
+                    cursor_queue,
+                    ctrl_evt,
+                    cursor_evt,
+                    interrupt_cb: interrupt_for_handler,
+                    kill_evt,
+                    pause_evt,
+                    access_platform,
+                    rutabaga,
+                };
+                handler.run(&paused, paused_sync.as_ref().unwrap())
+            },
+        )?;
+        event!("virtio-device", "activated", "id", &self.id);
+        Ok(())
+    }
+
+    fn reset(&mut self) {
+        event!("virtio-device", "reset", "id", &self.id);
+    }
+}
+
+impl Pausable for Gpu {
+    fn pause(&mut self) -> Result<(), MigratableError> {
+        self.common.pause()
+    }
+
+    fn resume(&mut self) -> Result<(), MigratableError> {
+        self.common.resume()
+    }
+}
+
+impl Snapshottable for Gpu {
+    fn id(&self) -> String {
+        self.id.clone()
+    }
+
+    fn snapshot(&mut self) -> Result<Snapshot, MigratableError> {
+        Snapshot::new_from_state(&self.state())
+    }
+}
+
+impl Transportable for Gpu {}
+impl Migratable for Gpu {}
