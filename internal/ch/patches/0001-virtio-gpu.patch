+fn gpu_host_rules() -> Vec<(i64, Vec<SeccompRule>)> {
+    // Device threads inherit this thread's filter, and seccomp filters stack
+    // -- the most restrictive wins -- so a permissive filter on the GPU
+    // thread cannot re-permit what this one denies. The renderer therefore
+    // needs its whole syscall set here too, including an unconditional ioctl:
+    // it issues DRM ioctls that the hypervisor allowlist does not cover.
