# Hangar guest kernel: aarch64-specific options.
#
# Merged after hangar.config when KARCH=arm64. Cloud Hypervisor presents a
# device-tree machine with a generic PCIe host bridge, a GICv3 and a PL011
# UART.
#
# These live in their own file because the build asserts that every option a
# fragment asks for survives olddefconfig. An arch-specific option is absent
# rather than disabled on the other architecture, which would make that
# assertion unenforceable if the two sets shared a file.

CONFIG_OF=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_ARM_AMBA=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_PSCI_FW=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# The persistent-memory flush instructions, for virtio-pmem (hangar.config).
CONFIG_ARM64_PMEM=y
# Cloud Hypervisor describes no pmem regions in the device tree.
# CONFIG_OF_PMEM is not set

# tinyconfig allows 512, which moves every CPU mask off the stack; a
# template asks for at most 64 vCPUs.
CONFIG_NR_CPUS=64
# 48-bit virtual addresses: three levels of page table fewer than 52 bits'
# five, with no CPU here supporting more than 48.
CONFIG_ARM64_VA_BITS_48=y

# CPU features tinyconfig turns off, each used only where the CPU (and the
# hypervisor) offers it: hardware access and dirty flags (no fault on the
# first touch or write of a page), range TLB invalidation, shared TLB
# entries, SVE and SME for userspace, pointer authentication and BTI for
# userspace (the bases' binaries carry both), tagged addresses.
CONFIG_ARM64_HW_AFDBM=y
CONFIG_ARM64_TLB_RANGE=y
CONFIG_ARM64_CNP=y
CONFIG_ARM64_SVE=y
CONFIG_ARM64_SME=y
CONFIG_ARM64_PTR_AUTH=y
# Switching keys on every kernel entry may trap when nested.
# CONFIG_ARM64_PTR_AUTH_KERNEL is not set
CONFIG_ARM64_BTI=y
CONFIG_ARM64_TAGGED_ADDR_ABI=y
CONFIG_ARM64_EPAN=y
CONFIG_SCHED_MC=y

# Steal time from KVM, as on x86.
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_TIME_ACCOUNTING=y

# The PMU, so perf counts more than software events where the host offers
# one. x86 has it through PERF_EVENTS alone.
CONFIG_ARM_PMU=y

# The PL031 clock Cloud Hypervisor provides: arm64 has no kvmclock, so
# without it the clock reads 1970 until the agent sets it.
CONFIG_RTC_DRV_PL031=y

# The power key: Cloud Hypervisor's device tree has a PL061 GPIO controller
# with a gpio-keys node sending KEY_POWER.
CONFIG_GPIOLIB=y
CONFIG_GPIO_PL061=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y

# Workarounds for CPU errata: a guest runs on whatever cores its host has
# (Neoverse in Graviton and Ampere Altra, AmpereOne, ...), and each is
# applied only on a core that needs it.
CONFIG_AMPERE_ERRATUM_AC03_CPU_38=y
CONFIG_AMPERE_ERRATUM_AC04_CPU_23=y
CONFIG_ARM64_ERRATUM_1024718=y
CONFIG_ARM64_ERRATUM_1165522=y
CONFIG_ARM64_ERRATUM_1319367=y
CONFIG_ARM64_ERRATUM_1463225=y
CONFIG_ARM64_ERRATUM_1508412=y
CONFIG_ARM64_ERRATUM_1530923=y
CONFIG_ARM64_ERRATUM_2051678=y
CONFIG_ARM64_ERRATUM_2054223=y
CONFIG_ARM64_ERRATUM_2067961=y
CONFIG_ARM64_ERRATUM_2077057=y
CONFIG_ARM64_ERRATUM_2457168=y
CONFIG_ARM64_ERRATUM_2645198=y
CONFIG_ARM64_ERRATUM_2658417=y
CONFIG_ARM64_ERRATUM_2966298=y
CONFIG_ARM64_ERRATUM_3117295=y
CONFIG_ARM64_ERRATUM_3194386=y
CONFIG_ARM64_ERRATUM_4118414=y
CONFIG_ARM64_ERRATUM_4311569=y
CONFIG_ARM64_ERRATUM_819472=y
CONFIG_ARM64_ERRATUM_824069=y
CONFIG_ARM64_ERRATUM_826319=y
CONFIG_ARM64_ERRATUM_827319=y
CONFIG_ARM64_ERRATUM_832075=y
CONFIG_ARM64_ERRATUM_843419=y
CONFIG_ARM64_ERRATUM_858921=y
CONFIG_CAVIUM_ERRATUM_22375=y
CONFIG_CAVIUM_ERRATUM_23154=y
CONFIG_CAVIUM_ERRATUM_27456=y
CONFIG_CAVIUM_ERRATUM_30115=y
CONFIG_CAVIUM_TX2_ERRATUM_219=y
CONFIG_FSL_ERRATUM_A008585=y
CONFIG_FUJITSU_ERRATUM_010001=y
CONFIG_HISILICON_ERRATUM_161010101=y
CONFIG_HISILICON_ERRATUM_161600802=y
CONFIG_HISILICON_ERRATUM_162100125=y
CONFIG_HISILICON_ERRATUM_162100801=y
CONFIG_NVIDIA_CARMEL_CNP_ERRATUM=y
CONFIG_QCOM_FALKOR_ERRATUM_1003=y
CONFIG_QCOM_FALKOR_ERRATUM_1009=y
CONFIG_QCOM_FALKOR_ERRATUM_E1041=y
CONFIG_QCOM_QDF2400_ERRATUM_0065=y
CONFIG_ROCKCHIP_ERRATUM_3568002=y
CONFIG_ROCKCHIP_ERRATUM_3588001=y
CONFIG_SOCIONEXT_SYNQUACER_PREITS=y

# Mitigations built in like the rest (the worker boots with
# mitigations=off): branch history, and the kernel unmapped at EL0.
CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY=y
CONFIG_UNMAP_KERNEL_AT_EL0=y

# More features used where the CPU has them: shadow stacks for userspace
# (GCS), permission overlays, kernel addresses kept from EL0 (E0PD), RAS
# error records, activity monitors, unprivileged loads and stores; and the
# scheduler's SMT, cluster and cache topology.
CONFIG_ARM64_GCS=y
CONFIG_ARM64_POE=y
CONFIG_ARM64_E0PD=y
CONFIG_ARM64_RAS_EXTN=y
CONFIG_ARM64_AMU_EXTN=y
CONFIG_ARM64_LSUI=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_CLUSTER=y
CONFIG_SCHED_CACHE=y
CONFIG_RELR=y

# Defaults left off on purpose (see hangar.config): EFI and ACPI (the guest
# boots from a device tree), CPU hotplug and hibernation, the console fonts
# (no framebuffer console), the timer's event stream (10 kHz wakeups of idle
# vCPUs), SMBIOS (arm64 reads it only through EFI), and what goes with an
# IOMMU and power domains.
# CONFIG_ARCH_HIBERNATION_POSSIBLE is not set
# CONFIG_ARCH_SUPPORTS_ACPI is not set
# CONFIG_ARCH_SUPPORTS_KEXEC is not set
# CONFIG_ARCH_USE_MEMREMAP_PROT is not set
# CONFIG_ARM64_PLATFORM_DEVICES is not set
# CONFIG_ARM_ARCH_TIMER_EVTSTREAM is not set
# CONFIG_ARM_SMCCC_SOC_ID is not set
# CONFIG_CPU_PM is not set
# CONFIG_DMI is not set
# CONFIG_DMIID is not set
# CONFIG_EFI is not set
# CONFIG_EFIVAR_FS is not set
# CONFIG_EFI_ARMSTUB_DTB_LOADER is not set
# CONFIG_EFI_EARLYCON is not set
# CONFIG_EFI_ESRT is not set
# CONFIG_EFI_GENERIC_STUB is not set
# CONFIG_EFI_PARAMS_FROM_FDT is not set
# CONFIG_EFI_RUNTIME_WRAPPERS is not set
# CONFIG_EFI_STUB is not set
# CONFIG_FONT_8x16 is not set
# CONFIG_FONT_AUTOSELECT is not set
# CONFIG_FONT_SUPPORT is not set
# CONFIG_GENERIC_IRQ_MIGRATION is not set
# CONFIG_HAVE_ARCH_GET_SECUREBOOT is not set
# CONFIG_HOTPLUG_CORE_SYNC is not set
# CONFIG_HOTPLUG_CORE_SYNC_DEAD is not set
# CONFIG_HOTPLUG_CPU is not set
# CONFIG_HOTPLUG_SMT is not set
# CONFIG_IOMMU_DEFAULT_DMA_STRICT is not set
# CONFIG_NLS is not set
# CONFIG_OF_IOMMU is not set
# CONFIG_PCI_LABEL is not set
# CONFIG_PM_CLK is not set
# CONFIG_SOC_BUS is not set
# CONFIG_UCS2_STRING is not set
# CONFIG_ZONE_DMA32 is not set
