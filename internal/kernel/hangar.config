# Hangar guest kernel configuration.
#
# Merged onto `tinyconfig`, which is allnoconfig plus the handful of options
# needed to build at all. Starting from nothing rather than from `defconfig`
# means nothing is in this kernel unless it is listed here: a guest sees a
# fixed, known device model -- virtio-blk, virtio-net, virtio-gpu, virtio-rng,
# balloon, virtio-mem, vsock, virtiofs and a serial port -- and nothing else
# can ever appear, so every driver defconfig would bring is dead weight.
#
# Three rules:
#
#   1. No modules. A module is either for hardware that cannot exist, or for a
#      feature that should be built in. CONFIG_MODULES=n also removes loading
#      kernel code as a privilege-escalation path inside the guest, and means
#      there is no /lib/modules to keep in step with the kernel.
#   2. Everything on the boot path is built in, necessarily -- the initramfs
#      assembles an overlay root before any filesystem exists to load from.
#   3. Everything "normal software" needs is listed explicitly. tinyconfig
#      disables futex, epoll, eventfd, POSIX timers and even multi-user
#      support; glibc, systemd and Docker all fall over without them.

# ---------------------------------------------------------------------------
# Core kernel. tinyconfig switches all of this off; ordinary userspace needs it.
# ---------------------------------------------------------------------------
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y

# tinyconfig builds for size: -Os throughout, and SLUB_TINY, the allocator for
# machines with a few megabytes, which gives up the per-CPU slab caches so
# every allocation on every vCPU takes a shared lock. Both cost the syscall
# and filesystem paths a developer's workload lives in.
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_SLUB_TINY is not set

# Every seccomp filter -- Docker's for each container syscall, systemd's
# SystemCallFilter=, Chromium's sandbox -- and every cgroup device program is
# BPF. Without the JIT each one is interpreted, on every syscall it guards.
CONFIG_BPF_JIT=y

# What systemd, debuggers and container tools expect that tinyconfig drops:
# name_to_handle_at (systemd lists it as required), process_vm_readv
# (profilers), pressure stall information (systemd-oomd), binfmt_misc
# (multi-architecture builds through qemu-user), CRIU's interfaces, delay
# accounting (iotop), userfaultfd, hugetlbfs.
CONFIG_FHANDLE=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_PSI=y
CONFIG_BINFMT_MISC=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_USERFAULTFD=y
CONFIG_HUGETLBFS=y
# The guest has no /boot/config-*: tools that check for a feature (Docker's
# check-config, bpftrace) read /proc/config.gz.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Multi-generational LRU: cheaper and better reclaim under memory pressure,
# as distribution kernels ship it.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# struct pages initialised by parallel threads rather than serially at boot.
CONFIG_DEFERRED_STRUCT_PAGE_INIT=y

# tinyconfig leaves both of these off, and the defaults are wrong for us.
#
# Without HIGH_RES_TIMERS every sleep and timer rounds up to the next tick. At
# HZ=250 that is 4ms: a measured 100us nanosleep overshot by 3.9ms, which any
# timer-driven workload inherits -- runtimes, schedulers, network timeouts.
#
# Without NO_HZ_IDLE each vCPU takes 250 timer interrupts a second whether or
# not it has work. One idle environment wastes little; a node packed with idle
# environments wastes it per vCPU, which is a density cost rather than a
# latency one.
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_KALLSYMS=y
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_COREDUMP=y
CONFIG_SHMEM=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_PRINTK=y
# Timestamps on every line. Without them a boot log says what happened but not
# when, and "which probe costs half a second" is unanswerable.
CONFIG_PRINTK_TIME=y
CONFIG_SYSCTL=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_BLOCK=y
CONFIG_SMP=y
CONFIG_PCI=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_JUMP_LABEL=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
# The worker writes the initramfs uncompressed (vm.WriteInitrd), so no
# decompressor is ever used.
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_SWAP=y

# Every disk is backed by the host, which schedules its own I/O; a guest
# scheduler on top only adds a lock. Without these, blk-mq uses none.
# CONFIG_MQ_IOSCHED_DEADLINE is not set
# CONFIG_MQ_IOSCHED_KYBER is not set

# A panicked guest reboots after ten seconds instead of spinning a host core
# until someone notices; the worker boots it again. pvpanic tells the
# monitor first, so the worker can say why.
CONFIG_PANIC_TIMEOUT=10
CONFIG_PVPANIC=y
CONFIG_PVPANIC_PCI=y

# Only warnings and worse go to the serial console, every byte of which is
# a trap to the monitor (and costly when nested); the rest is in dmesg.
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=4

# BSD ptys are 256 device pairs udev processes at every boot, used by
# nothing; TIOCSTI lets a process type into another's terminal.
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LEGACY_TIOCSTI is not set

# ---------------------------------------------------------------------------
# Platform. The architecture-specific half of this -- the interrupt
# controller, timer, UART and firmware interface -- lives in
# hangar-arm64.config and hangar-x86_64.config.
# ---------------------------------------------------------------------------
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y

# ---------------------------------------------------------------------------
# virtio: the entire device model, because the monitor gives us nothing else.
# ---------------------------------------------------------------------------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# Only virtio devices exist: the legacy virtio transport, BTT sectors, the
# vmclock device and HID transports never match anything.
# CONFIG_VIRTIO_PCI_LEGACY is not set
# CONFIG_PTP_1588_CLOCK_VMCLOCK is not set
# CONFIG_BTT is not set
# CONFIG_HID_SUPPORT is not set
# Cloud Hypervisor has no PS/2 controller.
# CONFIG_SERIO is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_KEYBOARD_ATKBD is not set

# What userspace expects of a Linux machine and the device model leaves out:
# /dev/net/tun (rootless containers, VPNs), loop devices (mounting images),
# evdev (logind reads the power button through it), uinput (input
# automation on Wayland), and the RTC, so the clock is right from the first
# instruction of userspace.
CONFIG_TUN=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y

# Memory reclaim: virtio-mem for resize with guarantees, balloon free-page
# reporting for continuous passive reclaim.
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_VIRTIO_MEM=y
# Memory virtio-mem adds is usable at once, and movable, so it can be taken
# away again.
CONFIG_MHP_DEFAULT_ONLINE_TYPE_ONLINE_MOVABLE=y

# vsock carries the agent tunnel, so the control channel needs no network.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# virtiofs is the eventual rootfs transport.
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
# ext4 checksums every metadata block it writes with crc32c. The base config
# (tinyconfig) turns the CPU's CRC instructions off, which leaves a table
# lookup per byte: a third of an untar's cycles.
CONFIG_CRC_OPTIMIZATIONS=y

# hangar-router, as the root, takes requests over io_uring: one ring per CPU,
# with no read and write on /dev/fuse for each. Off until the fuse module's
# enable_uring parameter is set, which the router does.
CONFIG_FUSE_IO_URING=y

# DAX lets the guest map the host's page cache instead of asking for every
# page over FUSE. The window arrives as a virtio shared memory region, which
# the guest treats as device memory -- hence ZONE_DEVICE and the DAX stack
# underneath it.
CONFIG_ZONE_DEVICE=y
CONFIG_DAX=y
CONFIG_FS_DAX=y
CONFIG_FUSE_DAX=y

# virtio-pmem carries an image as persistent memory: the pmem block driver
# makes it /dev/pmemN with DAX, so a filesystem on it (erofs) maps the host's
# page cache directly, shared by every guest on the image, as the virtiofs
# window does, with lookups answered in the guest.
CONFIG_LIBNVDIMM=y
CONFIG_BLK_DEV_PMEM=y
CONFIG_VIRTIO_PMEM=y

# virtio-gpu for the accelerated desktop.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_UDMABUF=y

# ---------------------------------------------------------------------------
# Filesystems. All built in: the root is assembled before modules could load.
# ---------------------------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_OVERLAY_FS=y
# erofs lives under the MISC_FILESYSTEMS menu, so that has to be on for it to
# be reachable at all.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_FS_POSIX_ACL=y
CONFIG_EXPORTFS=y

# ---------------------------------------------------------------------------
# Nested Docker. From moby's own check-config.sh; a gap here surfaces as a
# confusing dockerd failure rather than a clear one.
# ---------------------------------------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_FAIR_GROUP_SCHED=y
# cpu.max: docker --cpus, systemd CPUQuota=.
CONFIG_CFS_BANDWIDTH=y

CONFIG_KEYS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y

CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y

# Both bases ship iptables built on the nf_tables backend -- `iptables v1.8.11
# (nf_tables)` -- so dockerd's iptables calls are translated into nftables
# rather than reaching x_tables directly. NFT_COMPAT is the shim that lets that
# backend use the x_tables extensions dockerd asks for. Without it every rule
# it installs fails with "Extension addrtype revision 0 not supported, missing
# kernel module?" and the daemon exits before it finishes starting -- which
# looks nothing like a netfilter problem from the outside.
CONFIG_NFT_COMPAT=y

CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y

# Native nftables rules (Docker's nftables backend, firewalld, kube-proxy's
# nftables mode, any `ct state established` rule), conntrack over netlink
# (the conntrack tool, Docker clearing UDP flows), and the iptables
# extensions kube-proxy and k3s use inside Docker.
CONFIG_NFT_CT=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_NUMGEN=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NF_LOG_SYSLOG=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# Docker's other network drivers (macvlan, ipvlan, overlay over VXLAN, as
# k3s's flannel uses) and the dummy device kube-proxy wants; WireGuard for
# wg-quick.
CONFIG_VXLAN=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_DUMMY=y
CONFIG_WIREGUARD=y

# NETFILTER_XTABLES_LEGACY stays off. It gates IP_NF_FILTER, IP_NF_NAT and
# IP_NF_TARGET_MASQUERADE -- the iptables-legacy tables -- which nothing in
# either base uses, since both drive netfilter through nf_tables. Enabling it
# would put a second rule engine in the guest for no gain.

# ---------------------------------------------------------------------------
# Networking.
# ---------------------------------------------------------------------------
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP_MULTICAST=y
CONFIG_SYN_COOKIES=y
# The sit0 fallback device it puts in every network namespace, every
# container's included, carries nothing.
# CONFIG_IPV6_SIT is not set

# Traffic control: tc, tc-BPF (eBPF networking tools, Cilium in kind), the
# fq_codel default systemd asks for, and netem for simulating bad networks.
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y

# ss's socket listings for UDP, unix, packet and netlink sockets.
CONFIG_INET_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_UNIX_DIAG=y
CONFIG_PACKET_DIAG=y
CONFIG_NETLINK_DIAG=y

# ---------------------------------------------------------------------------
# Memory.
# ---------------------------------------------------------------------------
# Same-page merging for programs that ask for it (systemd's MemoryKSM=). It
# does nothing for density across guests: their RAM is a shared memfd, for
# the vhost-user backends, and the host can only merge private memory.
CONFIG_KSM=y
CONFIG_TRANSPARENT_HUGEPAGE=y

# ---------------------------------------------------------------------------
# Security. The VM is the boundary between tenants, so neither AppArmor nor
# SELinux runs in a guest. Landlock does: it is how a process sandboxes
# itself (coding agents' sandboxes use it), and costs nothing unused. The BPF
# LSM serves systemd's RestrictFileSystems=.
#
# CPU-vulnerability mitigations are built in, so the kernel knows what the
# host's CPU needs; the worker boots guests with mitigations=off (internal/ch).
# ---------------------------------------------------------------------------
CONFIG_SECURITY=y
# /sys/kernel/security, where the running LSMs are listed and tools look to
# see which are active.
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_BPF_LSM=y
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_INTEGRITY is not set
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
# Locks on files an environment shares are taken for it from Hangar's
# server, through the agent (fs/hangar, in tree/).
CONFIG_HANGAR_SYNC=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_CPU_MITIGATIONS=y
CONFIG_AUDIT=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y

# ---------------------------------------------------------------------------
# Observability. perf, bpftrace, bcc and perf probe work in a guest as on a
# distribution kernel: tracepoints, function and syscall tracing, kprobes,
# uprobes, and BTF for CO-RE tools (a few megabytes per guest).
# ---------------------------------------------------------------------------
CONFIG_PERF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_FS=y
# A task stuck in D state (a FUSE or virtiofs request never answered) is
# reported with its stack.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_MAGIC_SYSRQ=y

# ---------------------------------------------------------------------------
# Explicitly not wanted. A guest cannot see this hardware, and CONFIG_MODULES
# would reintroduce the /lib/modules coupling this design removes.
# ---------------------------------------------------------------------------
# CONFIG_MODULES is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_MTD is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_INFINIBAND is not set
