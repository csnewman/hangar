# Hangar guest kernel: x86-64-specific options.
#
# Merged after hangar.config when KARCH=x86_64. Cloud Hypervisor presents an
# ACPI machine with an 8250 UART, and the guest runs paravirtualised under
# KVM.
#
# These live in their own file because the build asserts that every option a
# fragment asks for survives olddefconfig. An arch-specific option is absent
# rather than disabled on the other architecture, which would make that
# assertion unenforceable if the two sets shared a file.

CONFIG_ACPI=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# virtio-pci interrupts by MSI-X. Without it every device shares the
# IOAPIC's 24 legacy lines, and a guest with Hangar's devices runs out of
# them before the last is set up: virtio-fs then fails to probe and the
# guest has no root. arm64 has it through its PCI host bridge.
CONFIG_PCI_MSI=y
# tinyconfig allows 2; a template may ask for up to 64 vCPUs.
CONFIG_NR_CPUS=64
# A vCPU spinning on a lock whose holder the host has descheduled yields
# instead, which matters where vCPUs outnumber cores.
CONFIG_PARAVIRT_SPINLOCKS=y
