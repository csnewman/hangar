# Hangar guest kernel: x86-64-specific options.
#
# Merged after hangar.config when KARCH=x86_64. Cloud Hypervisor presents an
# ACPI machine with an 8250 UART, and the guest runs paravirtualised under
# KVM.
#
# These live in their own file because the build asserts that every option a
# fragment asks for survives olddefconfig. An arch-specific option is absent
# rather than disabled on the other architecture, which would make that
# assertion unenforceable if the two sets shared a file.

CONFIG_ACPI=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# virtio-pci interrupts by MSI-X. Without it every device shares the
# IOAPIC's 24 legacy lines, and a guest with Hangar's devices runs out of
# them before the last is set up: virtio-fs then fails to probe and the
# guest has no root. arm64 has it through its PCI host bridge.
CONFIG_PCI_MSI=y
# tinyconfig allows 2; a template may ask for up to 64 vCPUs.
CONFIG_NR_CPUS=64
# A vCPU spinning on a lock whose holder the host has descheduled yields
# instead, which matters where vCPUs outnumber cores.
CONFIG_PARAVIRT_SPINLOCKS=y

# Time the host takes from a vCPU is accounted as stolen rather than billed
# to whatever task was running, so the scheduler stays fair on a busy host.
CONFIG_PARAVIRT_TIME_ACCOUNTING=y
# PAT gives write-combining mappings (virtio-gpu's host-visible memory) their
# memory type; without it they fall back to uncached.
CONFIG_MTRR=y
CONFIG_X86_PAT=y
# The kernel decompresses itself at every boot; zstd is the fastest of the
# compressors the bzImage offers.
CONFIG_KERNEL_ZSTD=y
# 32-bit binaries and linux/386 containers, and the vsyscall page old glibc
# (centos:6-era containers) calls into.
CONFIG_IA32_EMULATION=y
CONFIG_X86_VSYSCALL_EMULATION=y
# Reliable kernel stacks for perf, BPF stack maps and oopses, at no runtime
# cost.
CONFIG_UNWINDER_ORC=y

# Hardware a guest never has: CPU frequency control and the turbo core
# priorities that bring it in, ACPI's battery, fan,
# thermal and AC devices, Intel's management engine and uncore, RAPL and
# C-state counters, the CPU's own random number instructions as a hwrng
# (virtio-rng is the source), PCI and SoC UARTs, and a VGA console.
# CONFIG_SCHED_MC_PRIO is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_ACPI_DEBUG is not set
# CONFIG_ACPI_AC is not set
# CONFIG_ACPI_BATTERY is not set
# CONFIG_ACPI_FAN is not set
# CONFIG_ACPI_THERMAL is not set
# CONFIG_ACPI_TABLE_UPGRADE is not set
# CONFIG_INTEL_MEI is not set
# CONFIG_X86_PKG_TEMP_THERMAL is not set
# CONFIG_PERF_EVENTS_INTEL_UNCORE is not set
# CONFIG_PERF_EVENTS_INTEL_RAPL is not set
# CONFIG_PERF_EVENTS_INTEL_CSTATE is not set
# CONFIG_HW_RANDOM_INTEL is not set
# CONFIG_HW_RANDOM_AMD is not set
# CONFIG_HW_RANDOM_VIA is not set
# CONFIG_SERIAL_8250_PCI is not set
# CONFIG_SERIAL_8250_EXAR is not set
# CONFIG_SERIAL_8250_LPSS is not set
# CONFIG_SERIAL_8250_MID is not set
# CONFIG_SERIAL_8250_PERICOM is not set
# CONFIG_VGA_CONSOLE is not set

# The CMOS clock Cloud Hypervisor provides, for /dev/rtc0 and alarm timers.
CONFIG_RTC_DRV_CMOS=y

# Defaults tinyconfig turns off: address-space randomisation, user-mode
# instruction prevention, machine checks (a memory error the host injects is
# handled, not a panic), protection keys (V8 sandboxes its code with them),
# the LDT and 16-bit segments (Wine, old binaries), SMBIOS information
# (/sys/class/dmi/id, systemd's machine identity) and the early console, for
# a boot that dies before the console is up.
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_X86_UMIP=y
CONFIG_X86_MCE=y
CONFIG_X86_MCE_INTEL=y
CONFIG_X86_MCE_AMD=y
CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS=y
CONFIG_MODIFY_LDT_SYSCALL=y
CONFIG_X86_16BIT=y
CONFIG_DMI=y
CONFIG_DMIID=y
CONFIG_EARLY_PRINTK=y
# Indirect branch tracking: the CPU refuses an indirect jump in the kernel
# to anywhere but a function's start, where the CPU has it (CET).
CONFIG_X86_KERNEL_IBT=y

# Defaults left off on purpose (see hangar.config): legacy PC hardware (ISA
# DMA, floppy, the PC speaker, i8253), suspend, the power supply and thermal
# classes, nested KVM (VIRTUALIZATION), runtime-switchable preemption (the
# kernel is built non-preemptible), split-lock detection (it slows the
# guest's offending program for the host's sake), port I/O from userspace.
# CONFIG_ACPI_SLEEP is not set
# CONFIG_APERTURE_HELPERS is not set
# CONFIG_ARCH_MAY_HAVE_PC_FDC is not set
# CONFIG_CPU_IDLE_GOV_LADDER is not set
# CONFIG_FIRMWARE_MEMMAP is not set
# CONFIG_GENERIC_ISA_DMA is not set
# CONFIG_I8253_LOCK is not set
# CONFIG_IOMMU_DEFAULT_DMA_LAZY is not set
# CONFIG_ISA_DMA_API is not set
# CONFIG_PCSPKR_PLATFORM is not set
# CONFIG_PERF_EVENTS_AMD_UNCORE is not set
# CONFIG_POWER_SUPPLY is not set
# CONFIG_PREEMPT_DYNAMIC is not set
# CONFIG_PREEMPT_RCU is not set
# CONFIG_SCHED_OMIT_FRAME_POINTER is not set
# CONFIG_SGETMASK_SYSCALL is not set
# CONFIG_THERMAL_HWMON is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_X86_BUS_LOCK_DETECT is not set
# CONFIG_X86_EXTENDED_PLATFORM is not set
# CONFIG_X86_IOPL_IOPERM is not set
# CONFIG_X86_PLATFORM_DEVICES is not set
# CONFIG_X86_VERBOSE_BOOTUP is not set
