# Hangar guest kernel: 16 KiB pages, for guests on a Mac (libkrun on
# Hypervisor.framework). Merged after hangar-arm64.config.
#
# Apple silicon maps guest memory 16 KiB at a time, and libkrun maps each
# GPU buffer a guest allocates into its memory: with 4 KiB pages a buffer's
# size and place are a 4 KiB multiple, which the Mac cannot map, and the
# GPU fails. With 16 KiB pages every buffer is a multiple of the Mac's.

# CONFIG_ARM64_4K_PAGES is not set
CONFIG_ARM64_16K_PAGES=y
