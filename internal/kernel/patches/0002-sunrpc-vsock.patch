+#if IS_REACHABLE(CONFIG_VSOCKETS)
+/*
+ * AF_VSOCK is a stream between a virtual machine and its host, carrying
+ * RPC records exactly as TCP does: reading, record marking and the
+ * backchannel are the stream code above. What differs is the socket
+ * itself -- no TCP options, vsock's own states and send credit -- and
+ * that a vsock client never binds a source port.
+ */
+
+/**
+ * xs_vsock_state_change - callback to handle vsock socket state changes
+ * @sk: socket whose state has changed
+ *
+ * vsock reports the TCP states it shares: TCP_ESTABLISHED once the peer
+ * accepts, TCP_CLOSING or TCP_CLOSE once either end shuts the stream or
+ * the peer resets it.
+ */
+static void xs_vsock_state_change(struct sock *sk)
+{
+	struct rpc_xprt *xprt;
+	struct sock_xprt *transport;
+
+	if (!(xprt = xprt_from_sock(sk)))
+		return;
+	transport = container_of(xprt, struct sock_xprt, xprt);
+	trace_rpc_socket_state_change(xprt, sk->sk_socket);
+
+	if (sk->sk_state == TCP_ESTABLISHED &&
+	    !(sk->sk_shutdown & SHUTDOWN_MASK) && !sock_flag(sk, SOCK_DONE)) {
+		if (!xprt_test_and_set_connected(xprt)) {
+			xprt->connect_cookie++;
+			clear_bit(XPRT_SOCK_CONNECTING, &transport->sock_state);
+			xprt_clear_connecting(xprt);
+
+			xprt->stat.connect_count++;
+			xprt->stat.connect_time += (long)jiffies -
+						   xprt->stat.connect_start;
+			xs_run_error_worker(transport, XPRT_SOCK_WAKE_PENDING);
+		}
+		return;
+	}
+	if (sk->sk_state == TCP_SYN_SENT)
+		return;
+
+	xprt->connect_cookie++;
+	if (test_and_clear_bit(XPRT_SOCK_CONNECTING, &transport->sock_state))
+		xprt_clear_connecting(xprt);
+	clear_bit(XPRT_CONNECTED, &xprt->state);
+	if (xprt->reestablish_timeout < XS_TCP_INIT_REEST_TO)
+		xprt->reestablish_timeout = XS_TCP_INIT_REEST_TO;
+	/* Trigger the socket release */
+	xs_run_error_worker(transport, XPRT_SOCK_WAKE_DISCONNECT);
+}
+
+/*
+ * vsock sends against the peer's credit, which sk_wmem accounting does
+ * not see: the stream has room when the peer has granted some. Credit
+ * arrives under the socket lock, so checking it under that lock cannot
+ * miss the wakeup.
+ */
+static int xs_vsock_nospace(struct rpc_rqst *req)
+{
+	struct sock_xprt *transport =
+		container_of(req->rq_xprt, struct sock_xprt, xprt);
+	struct sock *sk = transport->inet;
+	int ret = -EAGAIN;
+
+	lock_sock(sk);
+	if (vsock_stream_has_space(vsock_sk(sk)) <= 0)
+		ret = xs_nospace(req, transport);
+	release_sock(sk);
+	return ret;
+}
+
+/**
+ * xs_vsock_send_request - write an RPC request to a vsock socket
+ * @req: pointer to RPC request
+ *
+ * Return values:
+ *        0:	The request has been sent
+ *   EAGAIN:	The socket was blocked, please call again later to
+ *		complete the request
+ * ENOTCONN:	Caller needs to invoke connect logic then call again
+ *    other:	Some other error occurred, the request was not sent
+ */
+static int xs_vsock_send_request(struct rpc_rqst *req)
+{
+	struct rpc_xprt *xprt = req->rq_xprt;
+	struct sock_xprt *transport = container_of(xprt, struct sock_xprt, xprt);
+	struct xdr_buf *xdr = &req->rq_snd_buf;
+	rpc_fraghdr rm = xs_stream_record_marker(xdr);
+	unsigned int msglen = rm ? req->rq_slen + sizeof(rm) : req->rq_slen;
+	struct msghdr msg = {
+		.msg_flags	= XS_SENDMSG_FLAGS,
+	};
+	unsigned int sent;
+	int status;
+
+	/* Close the stream if the previous transmission was incomplete */
+	if (xs_send_request_was_aborted(transport, req)) {
+		if (transport->sock != NULL)
+			kernel_sock_shutdown(transport->sock, SHUT_RDWR);
+		return -ENOTCONN;
+	}
+	if (!transport->inet)
+		return -ENOTCONN;
+
+	xs_pktdump("packet data:",
+				req->rq_svec->iov_base,
+				req->rq_svec->iov_len);
+
+	req->rq_xtime = ktime_get();
+	do {
+		status = xprt_sock_sendmsg(transport->sock, &msg, xdr,
+					   transport->xmit.offset, rm, &sent);
+		transport->xmit.offset += sent;
+		req->rq_bytes_sent = transport->xmit.offset;
+		if (likely(req->rq_bytes_sent >= msglen)) {
+			req->rq_xmit_bytes_sent += transport->xmit.offset;
+			transport->xmit.offset = 0;
+			return 0;
+		}
+		WARN_ON_ONCE(sent == 0 && status == 0);
+	} while (status == 0);
+
+	switch (status) {
+	case -EAGAIN:
+		status = xs_vsock_nospace(req);
+		break;
+	case -ENOTSOCK:
+		status = -ENOTCONN;
+		break;
+	case -ECONNRESET:
+	case -ECONNREFUSED:
+	case -ENOTCONN:
+	case -ENOBUFS:
+	case -EPIPE:
+		break;
+	default:
+		dprintk("RPC:       sendmsg returned unrecognized error %d\n",
+			-status);
+	}
+	return status;
+}
+
+static int xs_vsock_finish_connecting(struct rpc_xprt *xprt,
+				      struct socket *sock)
+{
+	struct sock_xprt *transport = container_of(xprt, struct sock_xprt, xprt);
+
+	if (!transport->inet) {
+		struct sock *sk = sock->sk;
+
+		lock_sock(sk);
+
+		xs_save_old_callbacks(transport, sk);
+
+		sk->sk_user_data = xprt;
+		WRITE_ONCE(sk->sk_data_ready, xs_data_ready);
+		sk->sk_state_change = xs_vsock_state_change;
+		WRITE_ONCE(sk->sk_write_space, xs_write_space);
+		sk->sk_error_report = xs_error_report;
+		sk->sk_use_task_frag = false;
+
+		xprt_clear_connected(xprt);
+
+		/* Reset to new socket */
+		transport->sock = sock;
+		transport->inet = sk;
+
+		release_sock(sk);
+	}
+
+	xs_stream_start_connect(transport);
+
+	set_bit(XPRT_SOCK_CONNECTING, &transport->sock_state);
+	return kernel_connect(sock, (struct sockaddr_unsized *)xs_addr(xprt),
+			      xprt->addrlen, O_NONBLOCK);
+}
+
+/**
+ * xs_vsock_setup_socket - create a vsock socket and connect to the peer
+ * @work: queued work item
+ *
+ * Invoked by a work queue tasklet.
+ */
+static void xs_vsock_setup_socket(struct work_struct *work)
+{
+	struct sock_xprt *transport =
+		container_of(work, struct sock_xprt, connect_worker.work);
+	struct socket *sock = transport->sock;
+	struct rpc_xprt *xprt = &transport->xprt;
+	unsigned int pflags = current->flags;
+	struct file *filp;
+	int status;
+
+	if (atomic_read(&xprt->swapper))
+		current->flags |= PF_MEMALLOC;
+
+	if (xprt_connected(xprt))
+		goto out;
+	if (test_and_clear_bit(XPRT_SOCK_CONNECT_SENT,
+			       &transport->sock_state) ||
+	    !sock) {
+		xs_reset_transport(transport);
+		status = __sock_create(xprt->xprt_net, AF_VSOCK, SOCK_STREAM,
+				       0, &sock, 1);
+		if (status < 0) {
+			xprt_wake_pending_tasks(xprt, status);
+			goto out;
+		}
+		filp = sock_alloc_file(sock, O_NONBLOCK, NULL);
+		if (IS_ERR(filp)) {
+			xprt_wake_pending_tasks(xprt, PTR_ERR(filp));
+			goto out;
+		}
+		transport->file = filp;
+	}
+
+	dprintk("RPC:       worker connecting xprt %p via vsock to %s (port %s)\n",
+		xprt, xprt->address_strings[RPC_DISPLAY_ADDR],
+		xprt->address_strings[RPC_DISPLAY_PORT]);
+
+	status = xs_vsock_finish_connecting(xprt, sock);
+	trace_rpc_socket_connect(xprt, sock, status);
+	switch (status) {
+	case 0:
+	case -EINPROGRESS:
+		set_bit(XPRT_SOCK_CONNECT_SENT, &transport->sock_state);
+		if (xprt->reestablish_timeout < XS_TCP_INIT_REEST_TO)
+			xprt->reestablish_timeout = XS_TCP_INIT_REEST_TO;
+		fallthrough;
+	case -EALREADY:
+		goto out_unlock;
+	case -ECONNREFUSED:
+	case -ECONNRESET:
+	case -ENETUNREACH:
+	case -EHOSTUNREACH:
+	case -ENODEV:
+	case -ENOBUFS:
+	case -ENOTCONN:
+	case -ETIMEDOUT:
+		break;
+	default:
+		printk("%s: connect returned unhandled error %d\n",
+			__func__, status);
+		status = -EAGAIN;
+	}
+
+	/* xs_tcp_force_close() wakes tasks with a fixed error code.
+	 * We need to wake them first to ensure the correct error code.
+	 */
+	xprt_wake_pending_tasks(xprt, status);
+	xs_tcp_force_close(xprt);
+out:
+	xprt_clear_connecting(xprt);
+out_unlock:
+	xprt_unlock_connect(xprt, transport);
+	current_restore_flags(pflags, PF_MEMALLOC);
+}
