diff --git a/src/venus/vkr_metal.h b/src/venus/vkr_metal.h
new file mode 100644
index 0000000..e1bf7b7
--- /dev/null
+++ b/src/venus/vkr_metal.h
@@ -0,0 +1,88 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Venus over a Metal driver: the host exports memory as Metal heaps, never as
+ * file descriptors, but the guest is offered dma-buf and opaque fd memory all
+ * the same, since that is what its window systems share buffers with. Memory
+ * the guest exports is a blob mapped into it, as any host-visible memory is,
+ * and the resource made of it holds the memory's heap. Another context
+ * importing the resource imports the heap, which is the same memory. Each
+ * holder retains the heap, so it lives as long as the last of them.
+ */
+
+#ifndef VKR_METAL_H
+#define VKR_METAL_H
+
+#include "vkr_common.h"
+
+#ifdef __APPLE__
+
+#include <CoreFoundation/CFBase.h>
+
+/* From VK_EXT_external_memory_metal, which the protocol's headers predate. */
+#define VKR_STRUCTURE_TYPE_IMPORT_MEMORY_METAL_HANDLE_INFO_EXT ((VkStructureType)1000602000)
+#define VKR_STRUCTURE_TYPE_MEMORY_GET_METAL_HANDLE_INFO_EXT ((VkStructureType)1000602002)
+#define VKR_EXTERNAL_MEMORY_HANDLE_TYPE_MTLHEAP_BIT_EXT                                  \
+   ((VkExternalMemoryHandleTypeFlagBits)0x00040000)
+
+struct vkr_import_memory_metal_handle_info {
+   VkStructureType sType;
+   const void *pNext;
+   VkExternalMemoryHandleTypeFlagBits handleType;
+   void *handle;
+};
+
+struct vkr_memory_get_metal_handle_info {
+   VkStructureType sType;
+   const void *pNext;
+   VkDeviceMemory memory;
+   VkExternalMemoryHandleTypeFlagBits handleType;
+};
+
+typedef VkResult(VKAPI_PTR *vkr_get_memory_metal_handle_fn)(
+   VkDevice device, const struct vkr_memory_get_metal_handle_info *info, void **handle);
+
+#define VKR_FD_HANDLE_TYPES                                                              \
+   (VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT |                                      \
+    VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT)
+
+/* The guest's fd handle types, as the host's heap. */
+static inline void
+vkr_metal_handle_types(VkExternalMemoryHandleTypeFlags *types)
+{
+   if (*types & VKR_FD_HANDLE_TYPES)
+      *types = (*types & ~VKR_FD_HANDLE_TYPES) | VKR_EXTERNAL_MEMORY_HANDLE_TYPE_MTLHEAP_BIT_EXT;
+}
+
+/* The host's answer for a heap, as the guest's for its fd handle types. */
+static inline void
+vkr_metal_memory_properties(VkExternalMemoryProperties *props)
+{
+   if (!(props->compatibleHandleTypes & VKR_EXTERNAL_MEMORY_HANDLE_TYPE_MTLHEAP_BIT_EXT)) {
+      *props = (VkExternalMemoryProperties){ 0 };
+      return;
+   }
+   props->exportFromImportedHandleTypes =
+      (props->exportFromImportedHandleTypes & VKR_EXTERNAL_MEMORY_HANDLE_TYPE_MTLHEAP_BIT_EXT)
+         ? VKR_FD_HANDLE_TYPES
+         : 0;
+   props->compatibleHandleTypes = VKR_FD_HANDLE_TYPES;
+}
+
+static inline void *
+vkr_metal_retain(void *heap)
+{
+   return heap ? (void *)CFRetain(heap) : NULL;
+}
+
+static inline void
+vkr_metal_release(void *heap)
+{
+   if (heap)
+      CFRelease(heap);
+}
+
+#endif /* __APPLE__ */
+
+#endif /* VKR_METAL_H */
