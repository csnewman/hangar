+         (uint64_t)util_format_get_blocksize(layout->format.pipe) *
+         layout->width_px;
+      if (explicit_row_pitch_B < min_row_pitch_B ||
+          explicit_row_pitch_B % layout->align_B ||
+          explicit_row_pitch_B > UINT32_MAX) {
