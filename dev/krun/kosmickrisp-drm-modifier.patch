+              i++) {
+            if (list_info->pDrmFormatModifiers[i] == DRM_FORMAT_MOD_LINEAR)
+               has_linear = true;
+         }
+         if (!has_linear)
+            return vk_error(dev, VK_ERROR_FORMAT_NOT_SUPPORTED);
