+    // Where the host gives huge pages only to memory that asks for them
+    // (transparent_hugepage=madvise), guest RAM asks. On 4 KiB pages every
+    // TLB miss walks the host page tables too, at its worst under nested
+    // virtualization.
+    #[cfg(target_os = "linux")]
+    {
+        use vm_memory::{GuestMemory, GuestMemoryRegion};
+        for region in guest_mem.iter() {
+            // SAFETY: the range is the region's own mapping; the advice
+            // changes how it is backed, not what it holds.
+            unsafe {
+                libc::madvise(
+                    region.as_ptr().cast(),
+                    region.len() as usize,
+                    libc::MADV_HUGEPAGE,
+                )
+            };
+        }
+    }
