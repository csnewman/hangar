# The development front door. The Go server answers the API; Vite serves the
# UI with hot reload. Both are on one origin, as they are in production,
# where hangar-server serves the built UI itself.
{
	admin off
}

:8080 {
	handle /api/* {
		reverse_proxy server:8081
	}
	handle {
		reverse_proxy web:5173
	}
}
