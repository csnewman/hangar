    vkr_context_wait_ring_fini(ctx);
 
@@ -737,6 +738,7 @@ vkr_context_create(uint32_t ctx_id,
       goto err_ctx_ring_mutex;
 
    list_inithead(&ctx->rings);
+   vkr_record_init(&ctx->record);
 
    return ctx;
 
