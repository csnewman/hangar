+/*
+ * Copyright 2026 Hangar
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VKR_SNAPSHOT_H
+#define VKR_SNAPSHOT_H
+
+#include "vkr_common.h"
+
+struct vn_dispatch_context;
+struct vkr_cs_decoder;
+
+/* What a context has built, kept so that a fresh renderer can build it again.
+ *
+ * A Vulkan driver's state cannot be read out, but every command that built it
+ * passes through the decoder here. So the raw bytes of each command whose
+ * effect lasts -- object creation, memory binds, descriptor updates, command
+ * buffer recording -- are kept against the objects they concern, and dropped
+ * when those objects are destroyed, unless a later record names them.
+ * Replayed in their original order through
+ * the same decoder, they recreate every object under the id the guest already
+ * holds. What commands only use -- submits, waits, queries -- leaves its
+ * lasting effect in memory, which is read back directly.
+ */
+struct vkr_record {
+   mtx_t mutex;
+   struct list_head entries;
+   uint64_t next_seq;
+};
+
+/* Owners that are rings rather than objects are tagged, so the two id spaces
+ * cannot collide.
+ */
+#define VKR_RECORD_RING_TAG (1ull << 63)
+
+void
+vkr_record_init(struct vkr_record *rec);
+
+void
+vkr_record_fini(struct vkr_record *rec);
+
+/* Dispatches one command, recording it if its effect lasts. */
+void
+vkr_record_dispatch(struct vkr_context *ctx,
+                    struct vn_dispatch_context *dispatch,
+                    struct vkr_cs_decoder *dec);
+
+/* Called by a handler to say its command concerns an object, which the
+ * command's record then belongs to.
+ */
+void
+vkr_record_note(struct vkr_context *ctx, vkr_object_id id);
+
+/* An object is gone: records that belonged only to it go too, but for those
+ * a later record needs it for.
+ */
+void
+vkr_record_forget(struct vkr_context *ctx, vkr_object_id id);
+
+/* A command buffer was reset: its recorded commands go. */
+void
+vkr_record_reset_command_buffer(struct vkr_context *ctx, vkr_object_id cb);
+
+bool
+vkr_context_snapshot(struct vkr_context *ctx, int *out_fd);
+
+bool
+vkr_context_restore(struct vkr_context *ctx, int fd);
+
+#endif /* VKR_SNAPSHOT_H */
