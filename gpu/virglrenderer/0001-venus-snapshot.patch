diff --git a/src/venus/vkr_snapshot.c b/src/venus/vkr_snapshot.c
new file mode 100644
index 0000000..9cc1ab7
--- /dev/null
+++ b/src/venus/vkr_snapshot.c
@@ -0,0 +1,660 @@
+/*
+ * Copyright 2026 Hangar
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "vkr_snapshot.h"
+
+#include <errno.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "vkr_context.h"
+#include "vkr_cs.h"
+#include "vkr_device.h"
+#include "vkr_device_memory.h"
+#include "vkr_queue.h"
+#include "vkr_ring.h"
+#include "vn_protocol_renderer_dispatches.h"
+
+#define SNAPSHOT_MAGIC 0x53524b56u /* "VKRS" */
+#define SNAPSHOT_VERSION 1u
+
+enum record_kind {
+   /* creation, binds, descriptor updates: kept while any owner lives */
+   RECORD_STATE = 0,
+   /* a command buffer's recording: dropped when the buffer is reset */
+   RECORD_COMMAND_BUFFER = 1,
+};
+
+struct record_entry {
+   struct list_head head;
+   uint64_t seq;
+   uint32_t kind;
+   uint32_t cmd_type;
+   uint32_t owner_count;
+   vkr_object_id *owners;
+   uint32_t size;
+   uint8_t *bytes;
+};
+
+/* Owners noted by handlers while one command is being dispatched on this
+ * thread. A nested dispatch -- vkExecuteCommandStreamsMESA runs the commands
+ * of a stream from inside its own handler -- works above the outer command's
+ * notes and truncates back to them when it returns.
+ */
+static _Thread_local struct {
+   struct vkr_context *ctx;
+   bool active;
+   vkr_object_id *ids;
+   uint32_t count;
+   uint32_t cap;
+} pending;
+
+void
+vkr_record_init(struct vkr_record *rec)
+{
+   mtx_init(&rec->mutex, mtx_plain);
+   list_inithead(&rec->entries);
+   rec->next_seq = 0;
+}
+
+static void
+entry_free(struct record_entry *e)
+{
+   list_del(&e->head);
+   free(e->owners);
+   free(e->bytes);
+   free(e);
+}
+
+void
+vkr_record_fini(struct vkr_record *rec)
+{
+   list_for_each_entry_safe (struct record_entry, e, &rec->entries, head)
+      entry_free(e);
+   mtx_destroy(&rec->mutex);
+}
+
+void
+vkr_record_note(struct vkr_context *ctx, vkr_object_id id)
+{
+   if (!pending.active || pending.ctx != ctx)
+      return;
+   for (uint32_t i = 0; i < pending.count; i++) {
+      if (pending.ids[i] == id)
+         return;
+   }
+   if (pending.count == pending.cap) {
+      uint32_t cap = pending.cap ? pending.cap * 2 : 16;
+      vkr_object_id *ids = realloc(pending.ids, cap * sizeof(*ids));
+      if (!ids)
+         return;
+      pending.ids = ids;
+      pending.cap = cap;
+   }
+   pending.ids[pending.count++] = id;
+}
+
+static void
+record_add(struct vkr_context *ctx,
+           uint32_t kind,
+           uint32_t cmd_type,
+           const uint8_t *bytes,
+           uint32_t size,
+           const vkr_object_id *owners,
+           uint32_t owner_count)
+{
+   struct record_entry *e = calloc(1, sizeof(*e));
+   if (!e)
+      return;
+   e->owners = malloc(owner_count * sizeof(*owners));
+   e->bytes = malloc(size);
+   if (!e->owners || !e->bytes) {
+      free(e->owners);
+      free(e->bytes);
+      free(e);
+      return;
+   }
+   memcpy(e->owners, owners, owner_count * sizeof(*owners));
+   memcpy(e->bytes, bytes, size);
+   e->owner_count = owner_count;
+   e->size = size;
+   e->kind = kind;
+   e->cmd_type = cmd_type;
+
+   struct vkr_record *rec = &ctx->record;
+   mtx_lock(&rec->mutex);
+   e->seq = rec->next_seq++;
+   list_addtail(&e->head, &rec->entries);
+   mtx_unlock(&rec->mutex);
+}
+
+void
+vkr_record_reset_command_buffer(struct vkr_context *ctx, vkr_object_id cb)
+{
+   struct vkr_record *rec = &ctx->record;
+   mtx_lock(&rec->mutex);
+   list_for_each_entry_safe (struct record_entry, e, &rec->entries, head) {
+      if (e->kind == RECORD_COMMAND_BUFFER && e->owners[0] == cb)
+         entry_free(e);
+   }
+   mtx_unlock(&rec->mutex);
+}
+
+void
+vkr_record_forget(struct vkr_context *ctx, vkr_object_id id)
+{
+   struct vkr_record *rec = &ctx->record;
+   mtx_lock(&rec->mutex);
+   list_for_each_entry_safe (struct record_entry, e, &rec->entries, head) {
+      uint32_t kept = 0;
+      for (uint32_t i = 0; i < e->owner_count; i++) {
+         if (e->owners[i] != id)
+            e->owners[kept++] = e->owners[i];
+      }
+      e->owner_count = kept;
+      if (!kept)
+         entry_free(e);
+   }
+   mtx_unlock(&rec->mutex);
+}
+
+static uint64_t
+read_u64(const uint8_t *bytes, uint32_t size, uint32_t offset)
+{
+   uint64_t v = 0;
+   if (offset + sizeof(v) <= size)
+      memcpy(&v, bytes + offset, sizeof(v));
+   return v;
+}
+
+/* Decides whether a dispatched command's effect lasts, and what it belongs to.
+ *
+ * A command is laid out as its type, its flags, then its arguments, and every
+ * vkCmd* takes the command buffer first, so the buffer it records into is the
+ * eight bytes after the header. The memory binds name their target second.
+ * Everything else that lasts -- creation, descriptor updates, the binds that
+ * take arrays -- is reported by its handler through vkr_record_note.
+ */
+static void
+record_command(struct vkr_context *ctx,
+               uint32_t cmd_type,
+               const uint8_t *bytes,
+               uint32_t size,
+               const vkr_object_id *owners,
+               uint32_t owner_count)
+{
+   const vkr_object_id first = read_u64(bytes, size, 8);
+   const vkr_object_id second = read_u64(bytes, size, 16);
+
+   switch (cmd_type) {
+   case VK_COMMAND_TYPE_vkBeginCommandBuffer_EXT:
+      /* beginning a recording implicitly resets the buffer */
+      vkr_record_reset_command_buffer(ctx, first);
+      record_add(ctx, RECORD_COMMAND_BUFFER, cmd_type, bytes, size, &first, 1);
+      return;
+   case VK_COMMAND_TYPE_vkEndCommandBuffer_EXT:
+      record_add(ctx, RECORD_COMMAND_BUFFER, cmd_type, bytes, size, &first, 1);
+      return;
+   case VK_COMMAND_TYPE_vkResetCommandBuffer_EXT:
+      vkr_record_reset_command_buffer(ctx, first);
+      return;
+   case VK_COMMAND_TYPE_vkBindBufferMemory_EXT:
+   case VK_COMMAND_TYPE_vkBindImageMemory_EXT:
+      record_add(ctx, RECORD_STATE, cmd_type, bytes, size, &second, 1);
+      return;
+   case VK_COMMAND_TYPE_vkExecuteCommandStreamsMESA_EXT:
+      /* the commands it ran were each recorded as they ran */
+      return;
+   default:
+      break;
+   }
+
+   const char *name = vn_dispatch_command_name((VkCommandTypeEXT)cmd_type);
+   if (name && !strncmp(name, "vkCmd", 5)) {
+      record_add(ctx, RECORD_COMMAND_BUFFER, cmd_type, bytes, size, &first, 1);
+      return;
+   }
+
+   if (owner_count)
+      record_add(ctx, RECORD_STATE, cmd_type, bytes, size, owners, owner_count);
+}
+
+void
+vkr_record_dispatch(struct vkr_context *ctx,
+                    struct vn_dispatch_context *dispatch,
+                    struct vkr_cs_decoder *dec)
+{
+   const uint8_t *start = dec->cur;
+   uint32_t cmd_type = UINT32_MAX;
+   if (dec->end - start >= 8)
+      memcpy(&cmd_type, start, sizeof(cmd_type));
+
+   const bool was_active = pending.active;
+   struct vkr_context *const was_ctx = pending.ctx;
+   const uint32_t base = pending.count;
+   pending.active = true;
+   pending.ctx = ctx;
+
+   vn_dispatch_command(dispatch);
+
+   if (!vkr_cs_decoder_get_fatal(dec) && dec->cur > start) {
+      record_command(ctx, cmd_type, start, (uint32_t)(dec->cur - start),
+                     pending.ids + base, pending.count - base);
+   }
+
+   pending.count = base;
+   pending.active = was_active;
+   pending.ctx = was_ctx;
+}
+
+/* --- snapshot -------------------------------------------------------------- */
+
+struct growbuf {
+   uint8_t *data;
+   size_t size;
+   size_t cap;
+   bool failed;
+};
+
+static void
+put(struct growbuf *b, const void *p, size_t n)
+{
+   if (b->failed)
+      return;
+   if (b->size + n > b->cap) {
+      size_t cap = b->cap ? b->cap : 4096;
+      while (cap < b->size + n)
+         cap *= 2;
+      uint8_t *d = realloc(b->data, cap);
+      if (!d) {
+         b->failed = true;
+         return;
+      }
+      b->data = d;
+      b->cap = cap;
+   }
+   memcpy(b->data + b->size, p, n);
+   b->size += n;
+}
+
+static void
+put_u32(struct growbuf *b, uint32_t v)
+{
+   put(b, &v, sizeof(v));
+}
+
+static void
+put_u64(struct growbuf *b, uint64_t v)
+{
+   put(b, &v, sizeof(v));
+}
+
+/* Waits until nothing is in flight: every ring has consumed what the guest
+ * wrote to it, and every device is idle. The guest is paused, so nothing new
+ * arrives meanwhile.
+ */
+static void
+quiesce(struct vkr_context *ctx)
+{
+   for (int i = 0; i < 5000; i++) {
+      bool idle = true;
+      mtx_lock(&ctx->ring_mutex);
+      list_for_each_entry (struct vkr_ring, ring, &ctx->rings, head) {
+         if (ring->buffer.cur != atomic_load(ring->control.tail))
+            idle = false;
+      }
+      mtx_unlock(&ctx->ring_mutex);
+      if (idle)
+         break;
+      usleep(1000);
+   }
+
+   mtx_lock(&ctx->object_mutex);
+   hash_table_foreach (ctx->object_table, entry) {
+      struct vkr_object *obj = entry->data;
+      if (obj->type != VK_OBJECT_TYPE_DEVICE)
+         continue;
+      struct vkr_device *dev = (struct vkr_device *)obj;
+      dev->proc_table.DeviceWaitIdle(obj->handle.device);
+   }
+   mtx_unlock(&ctx->object_mutex);
+}
+
+/* Appends every device's memory contents, and the state of its fences and
+ * events, which live in the driver and not in any recorded command.
+ */
+static void
+put_device_state(struct vkr_context *ctx, struct growbuf *mem, struct growbuf *sync,
+                 uint32_t *mem_count, uint32_t *sync_count)
+{
+   mtx_lock(&ctx->object_mutex);
+   hash_table_foreach (ctx->object_table, entry) {
+      struct vkr_object *obj = entry->data;
+      if (obj->type != VK_OBJECT_TYPE_DEVICE)
+         continue;
+      struct vkr_device *dev = (struct vkr_device *)obj;
+      struct vn_device_proc_table *vk = &dev->proc_table;
+      VkDevice device = obj->handle.device;
+
+      mtx_lock(&dev->object_mutex);
+      list_for_each_entry (struct vkr_object, child, &dev->objects, track_head) {
+         switch (child->type) {
+         case VK_OBJECT_TYPE_DEVICE_MEMORY: {
+            struct vkr_device_memory *m = (struct vkr_device_memory *)child;
+            if (!(m->property_flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)) {
+               vkr_log("snapshot: memory %" PRIu64 " is not host visible; contents not kept",
+                       child->id);
+               break;
+            }
+            void *p = NULL;
+            if (vk->MapMemory(device, child->handle.device_memory, 0, VK_WHOLE_SIZE, 0,
+                              &p) != VK_SUCCESS) {
+               vkr_log("snapshot: mapping memory %" PRIu64 " failed", child->id);
+               break;
+            }
+            put_u64(mem, child->id);
+            put_u64(mem, m->allocation_size);
+            put(mem, p, m->allocation_size);
+            vk->UnmapMemory(device, child->handle.device_memory);
+            (*mem_count)++;
+            break;
+         }
+         case VK_OBJECT_TYPE_FENCE:
+            put_u64(sync, child->id);
+            put_u32(sync, VK_OBJECT_TYPE_FENCE);
+            put_u32(sync, vk->GetFenceStatus(device, child->handle.fence) == VK_SUCCESS);
+            (*sync_count)++;
+            break;
+         case VK_OBJECT_TYPE_EVENT:
+            put_u64(sync, child->id);
+            put_u32(sync, VK_OBJECT_TYPE_EVENT);
+            put_u32(sync, vk->GetEventStatus(device, child->handle.event) == VK_EVENT_SET);
+            (*sync_count)++;
+            break;
+         default:
+            break;
+         }
+      }
+      mtx_unlock(&dev->object_mutex);
+   }
+   mtx_unlock(&ctx->object_mutex);
+}
+
+bool
+vkr_context_snapshot(struct vkr_context *ctx, int *out_fd)
+{
+   quiesce(ctx);
+
+   struct growbuf b = { 0 };
+   put_u32(&b, SNAPSHOT_MAGIC);
+   put_u32(&b, SNAPSHOT_VERSION);
+
+   struct vkr_record *rec = &ctx->record;
+   mtx_lock(&rec->mutex);
+   uint32_t entry_count = 0;
+   list_for_each_entry (struct record_entry, e, &rec->entries, head)
+      entry_count++;
+   put_u32(&b, entry_count);
+   list_for_each_entry (struct record_entry, e, &rec->entries, head) {
+      put_u64(&b, e->seq);
+      put_u32(&b, e->kind);
+      put_u32(&b, e->cmd_type);
+      put_u32(&b, e->owner_count);
+      put(&b, e->owners, e->owner_count * sizeof(*e->owners));
+      put_u32(&b, e->size);
+      put(&b, e->bytes, e->size);
+   }
+   mtx_unlock(&rec->mutex);
+
+   mtx_lock(&ctx->ring_mutex);
+   uint32_t ring_count = 0;
+   list_for_each_entry (struct vkr_ring, ring, &ctx->rings, head)
+      ring_count++;
+   put_u32(&b, ring_count);
+   list_for_each_entry (struct vkr_ring, ring, &ctx->rings, head) {
+      put_u64(&b, ring->id);
+      put_u64(&b, ring->virtqueue_seqno);
+   }
+   mtx_unlock(&ctx->ring_mutex);
+
+   struct growbuf mem = { 0 }, sync = { 0 };
+   uint32_t mem_count = 0, sync_count = 0;
+   put_device_state(ctx, &mem, &sync, &mem_count, &sync_count);
+   put_u32(&b, mem_count);
+   put(&b, mem.data, mem.size);
+   put_u32(&b, sync_count);
+   put(&b, sync.data, sync.size);
+   free(mem.data);
+   free(sync.data);
+
+   if (b.failed || mem.failed || sync.failed) {
+      free(b.data);
+      return false;
+   }
+
+   int fd = memfd_create("vkr-snapshot", MFD_CLOEXEC);
+   bool ok = fd >= 0;
+   for (size_t off = 0; ok && off < b.size;) {
+      ssize_t n = write(fd, b.data + off, b.size - off);
+      if (n <= 0)
+         ok = false;
+      else
+         off += (size_t)n;
+   }
+   free(b.data);
+   if (!ok || lseek(fd, 0, SEEK_SET) != 0) {
+      if (fd >= 0)
+         close(fd);
+      return false;
+   }
+
+   vkr_log("snapshot: %u commands, %u rings, %u memories, %u sync objects",
+           entry_count, ring_count, mem_count, sync_count);
+   *out_fd = fd;
+   return true;
+}
+
+/* --- restore --------------------------------------------------------------- */
+
+struct reader {
+   const uint8_t *p;
+   const uint8_t *end;
+   bool failed;
+};
+
+static const void *
+take(struct reader *r, size_t n)
+{
+   if (r->failed || (size_t)(r->end - r->p) < n) {
+      r->failed = true;
+      return NULL;
+   }
+   const void *p = r->p;
+   r->p += n;
+   return p;
+}
+
+static uint32_t
+take_u32(struct reader *r)
+{
+   uint32_t v = 0;
+   const void *p = take(r, sizeof(v));
+   if (p)
+      memcpy(&v, p, sizeof(v));
+   return v;
+}
+
+static uint64_t
+take_u64(struct reader *r)
+{
+   uint64_t v = 0;
+   const void *p = take(r, sizeof(v));
+   if (p)
+      memcpy(&v, p, sizeof(v));
+   return v;
+}
+
+static struct vkr_queue *
+queue_of(struct vkr_context *ctx, struct vkr_device *dev)
+{
+   struct vkr_queue *found = NULL;
+   mtx_lock(&ctx->object_mutex);
+   hash_table_foreach (ctx->object_table, entry) {
+      struct vkr_object *obj = entry->data;
+      if (obj->type == VK_OBJECT_TYPE_QUEUE && ((struct vkr_queue *)obj)->device == dev) {
+         found = (struct vkr_queue *)obj;
+         break;
+      }
+   }
+   mtx_unlock(&ctx->object_mutex);
+   return found;
+}
+
+/* The device an object belongs to, found through each device's children. */
+static struct vkr_device *
+device_of(struct vkr_context *ctx, struct vkr_object *target)
+{
+   struct vkr_device *found = NULL;
+   mtx_lock(&ctx->object_mutex);
+   hash_table_foreach (ctx->object_table, entry) {
+      struct vkr_object *obj = entry->data;
+      if (obj->type != VK_OBJECT_TYPE_DEVICE)
+         continue;
+      struct vkr_device *dev = (struct vkr_device *)obj;
+      mtx_lock(&dev->object_mutex);
+      list_for_each_entry (struct vkr_object, child, &dev->objects, track_head) {
+         if (child == target) {
+            found = dev;
+            break;
+         }
+      }
+      mtx_unlock(&dev->object_mutex);
+      if (found)
+         break;
+   }
+   mtx_unlock(&ctx->object_mutex);
+   return found;
+}
+
+bool
+vkr_context_restore(struct vkr_context *ctx, int fd)
+{
+   struct stat st;
+   if (fstat(fd, &st) || st.st_size <= 0)
+      return false;
+   void *map = mmap(NULL, (size_t)st.st_size, PROT_READ, MAP_PRIVATE, fd, 0);
+   if (map == MAP_FAILED)
+      return false;
+   struct reader r = { .p = map, .end = (const uint8_t *)map + st.st_size };
+
+   if (take_u32(&r) != SNAPSHOT_MAGIC || take_u32(&r) != SNAPSHOT_VERSION) {
+      vkr_log("restore: not a snapshot this renderer wrote");
+      munmap(map, (size_t)st.st_size);
+      return false;
+   }
+
+   /* Commands, in the order they first ran. Each is replayed on its own, so
+    * one that cannot be applied again -- a command buffer that names an object
+    * destroyed since it was recorded, which Vulkan calls invalid and the
+    * guest will not submit -- costs that one command and not the rest.
+    * Replies are switched off: the guest is not waiting for them, and they
+    * would be written into its memory.
+    */
+   const uint32_t entry_count = take_u32(&r);
+   uint32_t replayed = 0, failed = 0;
+   ctx->restoring = true;
+   for (uint32_t i = 0; i < entry_count && !r.failed; i++) {
+      take_u64(&r); /* seq */
+      take_u32(&r); /* kind */
+      take_u32(&r); /* cmd_type */
+      const uint32_t owner_count = take_u32(&r);
+      take(&r, owner_count * sizeof(vkr_object_id));
+      const uint32_t size = take_u32(&r);
+      const uint8_t *bytes = take(&r, size);
+      if (!bytes || size < 8)
+         break;
+      uint8_t *cmd = malloc(size);
+      if (!cmd)
+         break;
+      memcpy(cmd, bytes, size);
+      memset(cmd + 4, 0, 4);
+      if (vkr_context_submit_cmd(ctx, cmd, size)) {
+         replayed++;
+      } else {
+         failed++;
+         ctx->cs_fatal_error = false;
+      }
+      free(cmd);
+   }
+   ctx->restoring = false;
+
+   const uint32_t ring_count = take_u32(&r);
+   for (uint32_t i = 0; i < ring_count && !r.failed; i++) {
+      const uint64_t id = take_u64(&r);
+      const uint64_t seqno = take_u64(&r);
+      mtx_lock(&ctx->ring_mutex);
+      list_for_each_entry (struct vkr_ring, ring, &ctx->rings, head) {
+         if (ring->id == id)
+            ring->virtqueue_seqno = seqno;
+      }
+      mtx_unlock(&ctx->ring_mutex);
+   }
+
+   const uint32_t mem_count = take_u32(&r);
+   uint32_t mem_ok = 0;
+   for (uint32_t i = 0; i < mem_count && !r.failed; i++) {
+      const uint64_t id = take_u64(&r);
+      const uint64_t size = take_u64(&r);
+      const void *data = take(&r, size);
+      struct vkr_object *obj = vkr_context_get_object(ctx, id);
+      if (!data || !obj || obj->type != VK_OBJECT_TYPE_DEVICE_MEMORY)
+         continue;
+      struct vkr_device_memory *m = (struct vkr_device_memory *)obj;
+      struct vn_device_proc_table *vk = &m->device->proc_table;
+      VkDevice device = m->device->base.handle.device;
+      void *p = NULL;
+      if (vk->MapMemory(device, obj->handle.device_memory, 0, VK_WHOLE_SIZE, 0, &p) ==
+          VK_SUCCESS) {
+         memcpy(p, data, size < m->allocation_size ? size : m->allocation_size);
+         vk->UnmapMemory(device, obj->handle.device_memory);
+         mem_ok++;
+      }
+   }
+
+   const uint32_t sync_count = take_u32(&r);
+   for (uint32_t i = 0; i < sync_count && !r.failed; i++) {
+      const uint64_t id = take_u64(&r);
+      const uint32_t type = take_u32(&r);
+      const uint32_t set = take_u32(&r);
+      struct vkr_object *obj = vkr_context_get_object(ctx, id);
+      if (!obj || !set)
+         continue;
+      struct vkr_device *dev = device_of(ctx, obj);
+      if (!dev)
+         continue;
+      struct vn_device_proc_table *vk = &dev->proc_table;
+      if (type == VK_OBJECT_TYPE_EVENT) {
+         vk->SetEvent(dev->base.handle.device, obj->handle.event);
+      } else if (type == VK_OBJECT_TYPE_FENCE) {
+         /* A fence comes back unsignaled; an empty submission signals it. */
+         struct vkr_queue *q = queue_of(ctx, dev);
+         if (q) {
+            mtx_lock(&q->vk_mutex);
+            vk->QueueSubmit(q->base.handle.queue, 0, NULL, obj->handle.fence);
+            mtx_unlock(&q->vk_mutex);
+            vk->WaitForFences(dev->base.handle.device, 1, &obj->handle.fence, VK_TRUE,
+                              UINT64_MAX);
+         }
+      }
+   }
+
+   const bool ok = !r.failed;
+   munmap(map, (size_t)st.st_size);
+   vkr_log("restore: %u of %u commands replayed (%u failed), %u of %u memories written",
+           replayed, entry_count, failed, mem_ok, mem_count);
+   return ok;
+}
