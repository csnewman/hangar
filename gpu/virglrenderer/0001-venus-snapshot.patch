diff --git a/src/proxy/proxy_context.c b/src/proxy/proxy_context.c
index 2780a540..dd350efa 100644
--- a/src/proxy/proxy_context.c
+++ b/src/proxy/proxy_context.c
@@ -506,6 +506,47 @@ proxy_context_attach_resource(struct virgl_context *base, struct virgl_resource
    proxy_context_resource_add(ctx, res_id);
 }
 
+static int
+proxy_context_snapshot(struct virgl_context *base, int *out_fd)
+{
+   struct proxy_context *ctx = (struct proxy_context *)base;
+   const struct render_context_op_snapshot_request req = {
+      .header.op = RENDER_CONTEXT_OP_SNAPSHOT,
+   };
+   if (!proxy_socket_send_request(&ctx->socket, &req, sizeof(req)))
+      return -1;
+
+   struct render_context_op_snapshot_reply reply;
+   int fd = -1;
+   int fd_count = 0;
+   if (!proxy_socket_receive_reply_with_fds(&ctx->socket, &reply, sizeof(reply), &fd, 1,
+                                            &fd_count))
+      return -1;
+   if (!reply.ok || fd_count != 1) {
+      if (fd_count)
+         close(fd);
+      return -1;
+   }
+   *out_fd = fd;
+   return 0;
+}
+
+static int
+proxy_context_restore(struct virgl_context *base, int fd)
+{
+   struct proxy_context *ctx = (struct proxy_context *)base;
+   const struct render_context_op_restore_request req = {
+      .header.op = RENDER_CONTEXT_OP_RESTORE,
+   };
+   if (!proxy_socket_send_request_with_fds(&ctx->socket, &req, sizeof(req), &fd, 1))
+      return -1;
+
+   struct render_context_op_restore_reply reply;
+   if (!proxy_socket_receive_reply(&ctx->socket, &reply, sizeof(reply)))
+      return -1;
+   return reply.ok ? 0 : -1;
+}
+
 static void
 proxy_context_destroy(struct virgl_context *base)
 {
@@ -563,6 +604,8 @@ proxy_context_init_base(struct proxy_context *ctx)
    ctx->base.get_fencing_fd = proxy_context_get_fencing_fd;
    ctx->base.retire_fences = proxy_context_retire_fences;
    ctx->base.submit_fence = proxy_context_submit_fence;
+   ctx->base.snapshot = proxy_context_snapshot;
+   ctx->base.restore = proxy_context_restore;
 }
 
 static bool
