+static void
+semaphore_set(VkSemaphore handle, bool signaled)
+{
+   struct vkr_semaphore *sem = vkr_semaphore_from_handle(handle);
+   if (sem && !sem->timeline)
+      sem->signaled = signaled;
+}
+
+static void
+semaphores_set(const VkSemaphore *handles, uint32_t count, bool signaled)
+{
+   for (uint32_t i = 0; i < count; i++)
+      semaphore_set(handles[i], signaled);
+}
