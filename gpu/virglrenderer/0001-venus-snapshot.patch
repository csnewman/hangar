diff --git a/src/proxy/proxy_context.c b/src/proxy/proxy_context.c
index 2780a54..dd350ef 100644
--- a/src/proxy/proxy_context.c
+++ b/src/proxy/proxy_context.c
@@ -506,6 +506,47 @@ proxy_context_attach_resource(struct virgl_context *base, struct virgl_resource
    proxy_context_resource_add(ctx, res_id);
 }
 
+static int
+proxy_context_snapshot(struct virgl_context *base, int *out_fd)
+{
+   struct proxy_context *ctx = (struct proxy_context *)base;
+   const struct render_context_op_snapshot_request req = {
+      .header.op = RENDER_CONTEXT_OP_SNAPSHOT,
+   };
+   if (!proxy_socket_send_request(&ctx->socket, &req, sizeof(req)))
+      return -1;
+
+   struct render_context_op_snapshot_reply reply;
+   int fd = -1;
+   int fd_count = 0;
+   if (!proxy_socket_receive_reply_with_fds(&ctx->socket, &reply, sizeof(reply), &fd, 1,
+                                            &fd_count))
+      return -1;
+   if (!reply.ok || fd_count != 1) {
+      if (fd_count)
+         close(fd);
+      return -1;
+   }
+   *out_fd = fd;
+   return 0;
+}
+
+static int
+proxy_context_restore(struct virgl_context *base, int fd)
+{
+   struct proxy_context *ctx = (struct proxy_context *)base;
+   const struct render_context_op_restore_request req = {
+      .header.op = RENDER_CONTEXT_OP_RESTORE,
+   };
+   if (!proxy_socket_send_request_with_fds(&ctx->socket, &req, sizeof(req), &fd, 1))
+      return -1;
+
+   struct render_context_op_restore_reply reply;
+   if (!proxy_socket_receive_reply(&ctx->socket, &reply, sizeof(reply)))
+      return -1;
+   return reply.ok ? 0 : -1;
+}
+
 static void
 proxy_context_destroy(struct virgl_context *base)
 {
@@ -563,6 +604,8 @@ proxy_context_init_base(struct proxy_context *ctx)
    ctx->base.get_fencing_fd = proxy_context_get_fencing_fd;
    ctx->base.retire_fences = proxy_context_retire_fences;
    ctx->base.submit_fence = proxy_context_submit_fence;
+   ctx->base.snapshot = proxy_context_snapshot;
+   ctx->base.restore = proxy_context_restore;
 }
 
 static bool
diff --git a/src/venus/vkr_buffer.c b/src/venus/vkr_buffer.c
index 9e466f8..0673a8f 100644
--- a/src/venus/vkr_buffer.c
+++ b/src/venus/vkr_buffer.c
@@ -84,12 +84,19 @@ vkr_dispatch_vkBindBufferMemory(UNUSED struct vn_dispatch_context *dispatch,
 }
 
 static void
-vkr_dispatch_vkBindBufferMemory2(UNUSED struct vn_dispatch_context *dispatch,
+vkr_dispatch_vkBindBufferMemory2(struct vn_dispatch_context *dispatch,
                                  struct vn_command_vkBindBufferMemory2 *args)
 {
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
 
+   for (uint32_t i = 0; i < args->bindInfoCount; i++) {
+      const struct vkr_object *buf =
+         (const struct vkr_object *)(uintptr_t)args->pBindInfos[i].buffer;
+      if (buf)
+         vkr_record_note(dispatch->data, buf->id);
+   }
+
    vn_replace_vkBindBufferMemory2_args_handle(args);
    args->ret = vk->BindBufferMemory2(args->device, args->bindInfoCount, args->pBindInfos);
 }
diff --git a/src/venus/vkr_command_buffer.c b/src/venus/vkr_command_buffer.c
index 766c5c7..e6b12dc 100644
--- a/src/venus/vkr_command_buffer.c
+++ b/src/venus/vkr_command_buffer.c
@@ -47,12 +47,21 @@ vkr_dispatch_vkDestroyCommandPool(struct vn_dispatch_context *dispatch,
 }
 
 static void
-vkr_dispatch_vkResetCommandPool(UNUSED struct vn_dispatch_context *dispatch,
+vkr_dispatch_vkResetCommandPool(struct vn_dispatch_context *dispatch,
                                 struct vn_command_vkResetCommandPool *args)
 {
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
 
+   /* resetting the pool resets every buffer in it, recordings included */
+   struct vkr_command_pool *pool =
+      (struct vkr_command_pool *)(uintptr_t)args->commandPool;
+   if (pool) {
+      list_for_each_entry (struct vkr_command_buffer, cb, &pool->command_buffers,
+                           base.track_head)
+         vkr_record_reset_command_buffer(dispatch->data, cb->base.id);
+   }
+
    vn_replace_vkResetCommandPool_args_handle(args);
    args->ret = vk->ResetCommandPool(args->device, args->commandPool, args->flags);
 }
diff --git a/src/venus/vkr_context.c b/src/venus/vkr_context.c
index b97e5ea..138a8e4 100644
--- a/src/venus/vkr_context.c
+++ b/src/venus/vkr_context.c
@@ -172,7 +172,7 @@ vkr_context_submit_cmd(struct vkr_context *ctx, const void *buffer, size_t size)
    vkr_cs_decoder_set_buffer_stream(&ctx->decoder, buffer, size);
 
    while (vkr_cs_decoder_has_command(&ctx->decoder)) {
