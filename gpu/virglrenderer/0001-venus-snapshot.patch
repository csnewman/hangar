+   vkr_record_note(ctx, obj->id);
 }
 
 static inline void
@@ -207,6 +215,7 @@ vkr_context_remove_object_locked(struct vkr_context *ctx, struct vkr_object *obj
 
    struct hash_entry *entry = _mesa_hash_table_search(ctx->object_table, &obj->id);
    if (likely(entry)) {
