+         vkr_record_reset_command_buffer(dispatch->data, cb->base.id);
+   }
+
    vn_replace_vkResetCommandPool_args_handle(args);
    args->ret = vk->ResetCommandPool(args->device, args->commandPool, args->flags);
 }
