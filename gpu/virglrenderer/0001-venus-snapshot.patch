new file mode 100644
index 0000000..e0ac8d6
--- /dev/null
+++ b/src/venus/vkr_snapshot.h
@@ -0,0 +1,68 @@
+/*
+ * Copyright 2026 Hangar
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VKR_SNAPSHOT_H
+#define VKR_SNAPSHOT_H
+
+#include "vkr_common.h"
+
+struct vn_dispatch_context;
+struct vkr_cs_decoder;
+
+/* What a context has built, kept so that a fresh renderer can build it again.
+ *
+ * A Vulkan driver's state cannot be read out, but every command that built it
+ * passes through the decoder here. So the raw bytes of each command whose
+ * effect lasts -- object creation, memory binds, descriptor updates, command
+ * buffer recording -- are kept against the objects they concern, and dropped
+ * when those objects are destroyed. Replayed in their original order through
+ * the same decoder, they recreate every object under the id the guest already
+ * holds. What commands only use -- submits, waits, queries -- leaves its
+ * lasting effect in memory, which is read back directly.
+ */
+struct vkr_record {
+   mtx_t mutex;
+   struct list_head entries;
