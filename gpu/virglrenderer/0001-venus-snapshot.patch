diff --git a/server/render_context.c b/server/render_context.c
index b44b5b58..98baf798 100644
--- a/server/render_context.c
+++ b/server/render_context.c
@@ -122,6 +122,36 @@ render_context_dispatch_create_resource(struct render_context *ctx,
    return ok;
 }
 
+static bool
+render_context_dispatch_snapshot(struct render_context *ctx,
+                                 UNUSED const union render_context_op_request *request,
+                                 UNUSED const int *fds,
+                                 UNUSED int fd_count)
+{
+   struct render_context_op_snapshot_reply reply = { .ok = false };
+   int fd = -1;
+   reply.ok = render_state_snapshot_context(ctx->ctx_id, &fd);
+   if (!reply.ok)
+      return render_socket_send_reply(&ctx->socket, &reply, sizeof(reply));
+   bool ok = render_socket_send_reply_with_fds(&ctx->socket, &reply, sizeof(reply), &fd, 1);
+   close(fd);
+   return ok;
+}
+
+static bool
+render_context_dispatch_restore(struct render_context *ctx,
+                                UNUSED const union render_context_op_request *request,
+                                const int *fds,
+                                int fd_count)
+{
+   struct render_context_op_restore_reply reply = { .ok = false };
+   if (fd_count == 1) {
+      reply.ok = render_state_restore_context(ctx->ctx_id, fds[0]);
+      close(fds[0]);
+   }
+   return render_socket_send_reply(&ctx->socket, &reply, sizeof(reply));
+}
+
 static bool
 render_context_dispatch_init(struct render_context *ctx,
                              const union render_context_op_request *request,
@@ -192,6 +222,8 @@ static const struct render_context_dispatch_entry
       RENDER_CONTEXT_DISPATCH(DESTROY_RESOURCE, destroy_resource, 0),
       RENDER_CONTEXT_DISPATCH(SUBMIT_CMD, submit_cmd, 0),
       RENDER_CONTEXT_DISPATCH(SUBMIT_FENCE, submit_fence, 0),
+      RENDER_CONTEXT_DISPATCH(SNAPSHOT, snapshot, 0),
+      RENDER_CONTEXT_DISPATCH(RESTORE, restore, 1),
 #undef RENDER_CONTEXT_DISPATCH
    };
 
