diff --git a/server/render_context.c b/server/render_context.c
index b44b5b5..98baf79 100644
--- a/server/render_context.c
+++ b/server/render_context.c
@@ -122,6 +122,36 @@ render_context_dispatch_create_resource(struct render_context *ctx,
    return ok;
 }
 
+static bool
+render_context_dispatch_snapshot(struct render_context *ctx,
+                                 UNUSED const union render_context_op_request *request,
+                                 UNUSED const int *fds,
+                                 UNUSED int fd_count)
+{
+   struct render_context_op_snapshot_reply reply = { .ok = false };
+   int fd = -1;
+   reply.ok = render_state_snapshot_context(ctx->ctx_id, &fd);
+   if (!reply.ok)
+      return render_socket_send_reply(&ctx->socket, &reply, sizeof(reply));
+   bool ok = render_socket_send_reply_with_fds(&ctx->socket, &reply, sizeof(reply), &fd, 1);
+   close(fd);
+   return ok;
+}
+
+static bool
+render_context_dispatch_restore(struct render_context *ctx,
+                                UNUSED const union render_context_op_request *request,
+                                const int *fds,
+                                int fd_count)
+{
+   struct render_context_op_restore_reply reply = { .ok = false };
+   if (fd_count == 1) {
+      reply.ok = render_state_restore_context(ctx->ctx_id, fds[0]);
+      close(fds[0]);
+   }
+   return render_socket_send_reply(&ctx->socket, &reply, sizeof(reply));
+}
+
 static bool
 render_context_dispatch_init(struct render_context *ctx,
                              const union render_context_op_request *request,
@@ -192,6 +222,8 @@ static const struct render_context_dispatch_entry
       RENDER_CONTEXT_DISPATCH(DESTROY_RESOURCE, destroy_resource, 0),
       RENDER_CONTEXT_DISPATCH(SUBMIT_CMD, submit_cmd, 0),
       RENDER_CONTEXT_DISPATCH(SUBMIT_FENCE, submit_fence, 0),
+      RENDER_CONTEXT_DISPATCH(SNAPSHOT, snapshot, 0),
+      RENDER_CONTEXT_DISPATCH(RESTORE, restore, 1),
 #undef RENDER_CONTEXT_DISPATCH
    };
 
diff --git a/server/render_protocol.h b/server/render_protocol.h
index cae94a0..1636869 100644
--- a/server/render_protocol.h
+++ b/server/render_protocol.h
@@ -39,6 +39,8 @@ enum render_context_op {
    RENDER_CONTEXT_OP_DESTROY_RESOURCE,
    RENDER_CONTEXT_OP_SUBMIT_CMD,
    RENDER_CONTEXT_OP_SUBMIT_FENCE,
+   RENDER_CONTEXT_OP_SNAPSHOT,
+   RENDER_CONTEXT_OP_RESTORE,
 
    RENDER_CONTEXT_OP_COUNT,
 };
@@ -208,6 +210,24 @@ struct render_context_op_submit_fence_request {
    uint32_t seqno;
 };
 
+/* Write what the context has built into a file, sent back with the reply. */
+struct render_context_op_snapshot_request {
+   struct render_context_op_header header;
+};
+
+struct render_context_op_snapshot_reply {
+   bool ok;
+};
+
+/* Rebuild the context from the snapshot file sent with the request. */
+struct render_context_op_restore_request {
+   struct render_context_op_header header;
+};
+
+struct render_context_op_restore_reply {
+   bool ok;
+};
+
 union render_context_op_request {
    struct render_context_op_header header;
    struct render_context_op_nop_request nop;
@@ -217,6 +237,8 @@ union render_context_op_request {
    struct render_context_op_destroy_resource_request destroy_resource;
    struct render_context_op_submit_cmd_request submit_cmd;
    struct render_context_op_submit_fence_request submit_fence;
+   struct render_context_op_snapshot_request snapshot;
+   struct render_context_op_restore_request restore;
 };
 
