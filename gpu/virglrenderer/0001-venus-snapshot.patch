--- a/src/venus/vkr_queue.h
+++ b/src/venus/vkr_queue.h
@@ -58,6 +58,11 @@ VKR_DEFINE_OBJECT_CAST(fence, VK_OBJECT_TYPE_FENCE, VkFence)
 
 struct vkr_semaphore {
    struct vkr_object base;
+   bool timeline;
+   /* Whether a binary semaphore holds a payload, as the commands seen here
