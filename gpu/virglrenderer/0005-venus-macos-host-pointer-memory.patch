+/* Chain the import of shared memory a vkr_mtl_shm holds: as its MTLBuffer, or
+ * by its host pointer where there is no Metal device to make one with.
+ */
+static void
+vkr_mtl_shm_chain_import(const struct vkr_mtl_shm *mtl_shm,
+                         const void *next,
+                         VkImportMemoryMetalHandleInfoEXT *metal_import,
+                         VkImportMemoryHostPointerInfoEXT *host_import,
+                         const void **out)
+{
+   if (mtl_shm->mtl_buffer) {
+      *metal_import = (VkImportMemoryMetalHandleInfoEXT){
+         .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_METAL_HANDLE_INFO_EXT,
+         .pNext = next,
+         .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_MTLBUFFER_BIT_EXT,
+         .handle = mtl_shm->mtl_buffer,
+      };
+      *out = metal_import;
+   } else {
+      *host_import = (VkImportMemoryHostPointerInfoEXT){
+         .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT,
+         .pNext = next,
+         .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+         .pHostPointer = mtl_shm->shm_ptr,
+      };
+      *out = host_import;
+   }
+}
