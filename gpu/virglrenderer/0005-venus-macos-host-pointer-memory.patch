+struct vkr_mtl_shm *
+vkr_mtl_shm_import(void *mtl_device, int fd)
+{
+   struct stat st;
+   if (fstat(fd, &st) || st.st_size <= 0 ||
+       st.st_size % getpagesize())
+      return NULL;
+
+   int shm_fd = os_dupfd_cloexec(fd);
+   if (shm_fd < 0)
+      return NULL;
+
+   return vkr_mtl_shm_wrap(mtl_device, shm_fd, st.st_size);
+}
