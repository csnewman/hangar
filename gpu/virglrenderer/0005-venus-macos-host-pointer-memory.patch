+/* The guest's memory type bits for host memory type bits.  A tiled image can
+ * only be bound to memory without host access when host-visible memory is
+ * imported by host pointer.
+ */
+static inline uint32_t
+vkr_physical_device_guest_memory_type_bits(const struct vkr_physical_device *physical_dev,
+                                           uint32_t bits,
+                                           bool tiled)
+{
+   if (!physical_dev->device_only_type_base)
+      return bits;
+
+   const uint32_t mask = physical_dev->device_only_type_mask;
+   const uint32_t device_only = (bits & mask) << physical_dev->device_only_type_base;
+   return (tiled ? bits & ~mask : bits) | device_only;
