          mtl_shm = vkr_mtl_shm_alloc(dev->mtl_device, alloc_info->allocationSize);
          if (!mtl_shm) {
@@ -357,13 +425,9 @@ vkr_dispatch_vkAllocateMemory(struct vn_dispatch_context *dispatch,
             return;
          }
 
-         local_metal_import = (VkImportMemoryMetalHandleInfoEXT){
