# Only what crates/worker/Dockerfile copies. Rust targets and build output
# elsewhere in the tree are gigabytes it never reads.
*
!crates/
!cloud-hypervisor/
!kernel/
!gpu/Cargo.toml
!gpu/Cargo.lock
!gpu/src/
!gpu/virglrenderer/
!images/
!dev/krun-build.sh
!deploy/proxmox/release-iso.sh
!api/
!web/
web/node_modules
web/dist
crates/agent/tests/service/node_modules
crates/target
crates/krun/libkrun
crates/krun/target
