# Only what crates/worker/Dockerfile copies. Rust targets and build output
# elsewhere in the tree are gigabytes it never reads.
*
!crates/
!cloud-hypervisor/
!internal/kernel/
!internal/image/scripts/
!gpu/Cargo.toml
!gpu/Cargo.lock
!gpu/src/
!gpu/virglrenderer/
!images/
!dev/krun-build.sh
crates/agent/tests/service/node_modules
crates/target
crates/krun/libkrun
crates/krun/target
