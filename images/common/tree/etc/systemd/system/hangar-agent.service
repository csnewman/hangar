[Unit]
Description=Hangar agent
# The agent dials the host over vsock and needs no network, no DNS and no
# mounted workspace, so it starts as early as systemd can run it. Being up
# before the rest of the environment is the point: that is when a stuck boot
# most needs to be observable.
#
# It is ordered after nothing. The guest kernel is monolithic, so vsock is
# present before userspace starts and there is no module to wait for.
DefaultDependencies=no
Before=sysinit.target

[Service]
Type=exec
ExecStart=/usr/local/bin/hangar-agent
# The host listener may not be up yet when the guest reaches this point, so a
# failure to connect must not hold up the boot.
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=sysinit.target
