#!/bin/sh
# Runs inside the image after packages are installed.
set -eu

# Which units start is set by the shared preset in ../common/tree, because
# mkosi applies presets after this script runs.

# Ubuntu ships a stock `ubuntu` user at uid 1000; it must go before `dev` can
# take that uid.
userdel -r ubuntu 2>/dev/null || true
# render and video open the GPU's device nodes, which the desktop and anything
# it runs draw through.
useradd -m -u 1000 -s /bin/bash -G sudo,docker,render,video dev
echo 'dev ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/dev
mkdir -p /workspace /var/lib/docker
chown dev:dev /workspace

printf 'hangar\n' > /etc/hostname

# Ubuntu's archive, for apt inside an environment. amd64 is served from
# archive.ubuntu.com and security.ubuntu.com, every other architecture from
# ports.ubuntu.com.
case "$(dpkg --print-architecture)" in
amd64)
	archive=http://archive.ubuntu.com/ubuntu
	security=http://security.ubuntu.com/ubuntu
	;;
*)
	archive=http://ports.ubuntu.com/ubuntu-ports
	security=$archive
	;;
esac
cat > /etc/apt/sources.list.d/ubuntu.sources <<EOF
Types: deb
URIs: $archive
Suites: resolute resolute-updates resolute-backports
Components: main universe
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb
URIs: $security
Suites: resolute-security
Components: main universe
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
EOF

# The hardware database maps device identifiers -- MAC vendor prefixes, PCI
# and USB vendor-model names, keyboard and mouse quirks -- onto udev
# properties. A guest sees virtio devices and a serial port, so it needs none
# of it, but udev rebuilds the index whenever one is not already present, and
# the trigger for that is literally `ConditionPathExists=|!/usr/lib/udev/hwdb.bin`.
#
# Without this the index is compiled from 9 MB of source on every boot of
# every environment, over virtio-fs. Building it once here costs image size
# that the page cache shares between guests.
#
# It must land in /usr, not /etc: a hwdb.bin under /etc is itself one of the
# conditions that makes the unit run.
systemd-hwdb update --usr
test -f /usr/lib/udev/hwdb.bin
test ! -e /etc/udev/hwdb.bin
