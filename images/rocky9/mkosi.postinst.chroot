#!/bin/sh
# Runs inside the image. Note the .chroot suffix: a plain mkosi.postinst runs on
# the build host with $BUILDROOT set, where systemctl queries the builder's own
# systemd and cannot see the image's units.
set -eu

# Which units start is set by the shared preset in ../common/tree, because
# mkosi applies presets after this script runs.

# docker-ce's rpm creates the docker group, so this runs after packages.
useradd -m -u 1000 -s /bin/bash -G wheel,docker dev
echo 'dev ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/dev
chmod 0440 /etc/sudoers.d/dev
mkdir -p /workspace /var/lib/docker
chown dev:dev /workspace

printf 'hangar\n' > /etc/hostname
