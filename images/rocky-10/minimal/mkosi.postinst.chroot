#!/bin/sh
# Runs inside the image after packages are installed.
set -eu

# Which units start is set by the shared presets in ../../common, because
# mkosi applies presets after this script runs.

useradd -m -u 1000 -s /bin/bash -G wheel dev
echo 'dev ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/dev
chmod 0440 /etc/sudoers.d/dev
mkdir -p /workspace /var/lib/docker
chown dev:dev /workspace

printf 'hangar\n' > /etc/hostname


# The hardware database index, built once here rather than by udev on every
# boot of every environment; images/ubuntu-26.04/minimal/mkosi.postinst.chroot
# has the whole story. It must land in /usr: one under /etc is itself a
# reason for udev to rebuild it.
systemd-hwdb update --usr
test -f /usr/lib/udev/hwdb.bin
test ! -e /etc/udev/hwdb.bin
