# Copy to .env beside compose.yaml.

# Control plane.
POSTGRES_PASSWORD=change-me
# Hangar's origin as browsers reach it. The server is the DNS server for its
# host, the zone, which is delegated to it (see README.md). Editors are
# served on the zone's subdomains, code<short>.<host>.
HANGAR_PUBLIC_URL=https://hangar.example.com
# prefix names editors and the registry code<short>-<host> and registry-<host>
# instead, for a network that resolves <anything>-<host> to this machine
# and has a wildcard certificate for its domain: set HANGAR_DNS_LISTEN= and
# the certificate files below too (README.md, Prefix host names).
HANGAR_HOST_STYLE=subdomain
# Where the database and the registry's blobs are kept on the host, in
# postgres/ and registry/: directories, not Docker volumes.
HANGAR_DATA_DIR=/var/lib/hangar-server
# Where a worker keeps environments' disks, images and caches on the host.
# The worker sees it as /var/lib/hangar, which worker.yaml names, wherever
# it is here. Set it to $HANGAR_DATA_DIR/worker to keep everything in one
# directory; moving one that is in use means stopping the worker first.
HANGAR_WORKER_DATA_DIR=/var/lib/hangar
# The first administrator, created on first start only.
HANGAR_ADMIN_USERNAME=admin
HANGAR_ADMIN_PASSWORD=

# The zone: every name in it resolves to these, the control plane's public
# addresses, IPv4 and/or IPv6, comma separated.
HANGAR_DNS_ADDRESSES=203.0.113.10
# The zone's nameservers, as the parent zone's NS records name them. Empty
# is ns1.<host>.
HANGAR_DNS_NAMESERVERS=
# Where the CA sends certificate expiry warnings.
HANGAR_ACME_EMAIL=admin@example.com
# The ACME directory. Empty is Let's Encrypt; its staging directory,
# https://acme-staging-v02.api.letsencrypt.org/directory, is for trying a
# deployment out without its rate limits.
HANGAR_ACME_CA=
# A certificate of your own, served instead of ACME's: put it (the chain,
# leaf first) and its key in ./tls and name them as the server sees them.
# HANGAR_TLS_CERT_FILE=/etc/hangar-server/tls/cert.pem
# HANGAR_TLS_KEY_FILE=/etc/hangar-server/tls/key.pem
# The host address ports 53, 443 and 80 are published on. On a host whose
# systemd-resolved holds 127.0.0.53:53, give the public address.
HANGAR_PUBLISH_ADDRESS=0.0.0.0
# Plain HTTP, published for a TLS terminator of your own; keep it local
# otherwise. To use one, also set HANGAR_DNS_LISTEN=, HANGAR_TLS_LISTEN= and
# HANGAR_REDIRECT_LISTEN= (empty) to turn the server's own off.
HANGAR_LISTEN=127.0.0.1:8081

# The SSH gateway: ssh <environment>@<host> -p 2222. Empty turns it off.
HANGAR_SSH_LISTEN=:2222
# Where people reach it, as host:port, when that is not HANGAR_PUBLIC_URL's
# host at the listen port.
HANGAR_SSH_ADDRESS=

# Paths shared in every user's profile beside the built-in ones, relative
# to the home directory and separated by commas; a directory ends in a
# slash. E.g. .config/nvim/,.bash_aliases
HANGAR_PROFILE_PATHS=

# Shared by the control plane and every worker: a long random string, e.g.
#   openssl rand -hex 32 > bootstrap-token
HANGAR_BOOTSTRAP_TOKEN_FILE=./bootstrap-token

# The control plane's alone: encrypts users' SSH keys. Losing it loses
# them, so back it up with the database.
#   openssl rand -hex 32 > secret-key
HANGAR_SECRET_KEY_FILE=./secret-key

# The control plane's object store, for profiles' files and the registry's
# blobs: the blobs service (RustFS) unless HANGAR_BLOB_URL names another,
# http(s)://<access key>@host[:port]/<bucket>. blob-secret-key is the key
# the server signs in with; blob-sse-key is the one RustFS encrypts with,
# which losing loses every file it keeps, so back it up.
#   openssl rand -hex 32 > blob-secret-key
#   openssl rand -base64 32 > blob-sse-key
HANGAR_BLOB_URL=
# The versioned bucket profiles' files are kept in, <bucket>-profiles
# unless set.
HANGAR_BLOB_PROFILE_BUCKET=
HANGAR_BLOB_ENCRYPT=true
HANGAR_BLOB_SECRET_KEY_FILE=./blob-secret-key
HANGAR_BLOB_SSE_KEY_FILE=./blob-sse-key

# false turns off the control plane's own container registry.
HANGAR_REGISTRY_ENABLED=true

# Where the server and worker images are pulled from, and which version.
# CI publishes both, multi-platform, as :latest and :<commit>.
HANGAR_REGISTRY=ghcr.io/csnewman/hangar
HANGAR_VERSION=latest
