# Copy to .env beside compose.yaml.

# Control plane.
POSTGRES_PASSWORD=change-me
# Hangar's origin as browsers reach it. The server is the DNS server for its
# host, the zone, which is delegated to it (see README.md). Editors are
# served on the zone's subdomains, e-<id>.<host>.
HANGAR_PUBLIC_URL=https://hangar.example.com
# The first administrator, created on first start only.
HANGAR_ADMIN_USERNAME=admin
HANGAR_ADMIN_PASSWORD=

# The zone: every name in it resolves to these, the control plane's public
# addresses, IPv4 and/or IPv6, comma separated.
HANGAR_DNS_ADDRESSES=203.0.113.10
# The zone's nameservers, as the parent zone's NS records name them. Empty
# is ns1.<host>.
HANGAR_DNS_NAMESERVERS=
# Where the CA sends certificate expiry warnings.
HANGAR_ACME_EMAIL=admin@example.com
# The ACME directory. Empty is Let's Encrypt; its staging directory,
# https://acme-staging-v02.api.letsencrypt.org/directory, is for trying a
# deployment out without its rate limits.
HANGAR_ACME_CA=
# The host address ports 53, 443 and 80 are published on. On a host whose
# systemd-resolved holds 127.0.0.53:53, give the public address.
HANGAR_PUBLISH_ADDRESS=0.0.0.0
# Plain HTTP, published for a TLS terminator of your own; keep it local
# otherwise. To use one, also set HANGAR_DNS_LISTEN=, HANGAR_TLS_LISTEN= and
# HANGAR_REDIRECT_LISTEN= (empty) to turn the server's own off.
HANGAR_LISTEN=127.0.0.1:8081

# Shared by the control plane and every worker: a long random string, e.g.
#   openssl rand -hex 32 > bootstrap-token
HANGAR_BOOTSTRAP_TOKEN_FILE=./bootstrap-token
